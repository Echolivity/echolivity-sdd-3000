       {
        "box": {
         "id": "obj-3",
         "maxclass": "codebox",
         "code": "// ECHOLIVITY SDD-3000 -- core DSP (gen~ codebox)\n// Independent homage to the 1982 Korg SDD-3000. Not a Korg product.\n// GENERATED by tools/make_gen.py -- edit the generator, not this file.\n// v1.0.2: HOLD release fix + NaN/Inf protection (see docs/ENGINEERING_CHANGES.md).\n\nParam p_in_range(2, min=0, max=2);   // input ATT  0=-30dBm(Hi-Z, extra amp) 1=-10dBm 2=+4dBm\nParam p_in_level(5, min=0, max=10);   // input LEVEL, 5 = nominal\nParam p_pre_on(1, min=0, max=1);   // preamp character stage on/off\nParam p_drive(0, min=0, max=24);   // extra drive into op-amp stage, dB\nParam p_tone(0, min=-1, max=1);   // tone tilt around 800 Hz (+-6 dB)\nParam p_pre_comp(1, min=0, max=1);   // auto output compensation for drive\nParam p_pre_trim(0, min=-24, max=24);   // preamp output trim, dB\nParam p_time_ms(380, min=0, max=1023);   // delay time, ms\nParam p_time_mode(0, min=0, max=1);   // 0=authentic 1 ms steps 1=continuous (modern)\nParam p_time_glide(0, min=0, max=1);   // 0=click-free crossfade 1=glide/pitch-bend (modern)\nParam p_sync(0, min=0, max=1);   // host tempo sync (modern)\nParam p_division(8, min=0, max=12);   // note division index (modern); rc5 appends 11 = 1/16T, 12 = 1/32T\nParam p_tempo(120, min=20, max=999);   // host tempo, BPM (sent by the patcher)\nParam p_feedback(3, min=0, max=10);   // FEEDBACK 0..10 (loop gain = value/7)\nParam p_fb_inv(0, min=0, max=1);   // regeneration INV\nParam p_lowcut(0, min=0, max=3);   // LOW filter 0=FLAT 1=125 2=250 3=500 Hz\nParam p_highcut(0, min=0, max=3);   // HIGH filter 0=FLAT 1=8k 2=4k 3=2k Hz\nParam p_lc_slope(0, min=0, max=1);   // LOW slope 0=-3 dB/oct (spec) 1=-6 dB/oct (alt)\nParam p_loop_sat(0, min=0, max=1);   // 0=converter hard clip (authentic) 1=soft loop saturation\nParam p_hold(0, min=0, max=1);   // HOLD\nParam p_fb_route(0, min=0, max=2);   // FB ROUTE 0=INT 1=EXT (send outs 3/4 -> return ins 3/4 replaces the internal loop) 2=BOTH\nParam p_return(5, min=0, max=10);   // EXT RETURN level 0..10 (loop gain = value/7, same law as FEEDBACK)\nParam p_loop_comp(0, min=0, max=250);   // LOOP COMP ms: shortens the delay in EXT so each external pass lands on time\nParam p_cal(0, min=0, max=1);   // CAL trigger (rising edge): measure the external loop's round trip\nParam p_waveform(0, min=0, max=3);   // 0=TRI 1=SQUARE 2=RND 3=ENV\nParam p_intensity(0, min=0, max=10);   // INTENSITY 0..10 (10 = 2:1)\nParam p_frequency(3, min=0, max=10);   // FREQUENCY 0..10 -> 0.1..15 Hz\nParam p_env_sens(0, min=-24, max=24);   // envelope sensitivity dB (modern)\nParam p_env_rel(1440, min=20, max=5000);   // envelope release ms (1440 = service-manual Fig.4)\nParam p_balance(5, min=0, max=10);   // LEVEL BALANCE 0=direct 5=1:1 10=effect\nParam p_out_inv(0, min=0, max=1);   // output INV (sum/difference on VARIABLE and +MIX)\nParam p_bypass(0, min=0, max=1);   // BYPASS: direct only, delay input muted (clears loop)\nParam p_out_range(2, min=0, max=2);   // output ATT 0=-20 1=-10 2=+4 dBm\nParam p_out_mode(0, min=0, max=3);   // 0=MONO(VAR) 1=STEREO A(DIR/+MIX) 2=STEREO B(+MIX/-MIX) 3=TRUE STEREO\nParam p_width(1, min=0, max=2);   // stereo width (modern)\nParam p_wet_only(0, min=0, max=1);   // wet only (modern)\nParam p_out_gain(0, min=-24, max=12);   // output gain dB (modern)\nParam p_converter(0, min=0, max=1);   // 0=13-bit gain-ranged converter 1=clean (modern)\nParam p_hf_comp(1, min=0, max=1);   // host-rate resampling droop compensation (engineering, keep on)\nParam p_reverse(0, min=0, max=3);   // REVERSE 0=OFF 1=REV (all repeats) 2=ALT (fwd, rev, fwd...) 3=ALT R (rev, fwd, rev...)\n\nData mem(65536, 2);\nData rmem(131072, 2);   // reverse: a copy of the recorded words, twice as long\nHistory h_cal_env(0);\nHistory h_cal_hold(0);\nHistory h_cal_m(0);\nHistory h_cal_n(0);\nHistory h_cal_prev(0);\nHistory h_cal_res(0);\nHistory h_cal_st(0);\nHistory h_dac_l(0);\nHistory h_dac_r(0);\nHistory h_dacr_l(0);\nHistory h_dacr_r(0);\nHistory h_envf(0);\nHistory h_eq_a1(0);\nHistory h_eq_a2(0);\nHistory h_eq_b0(0);\nHistory h_eq_b1(0);\nHistory h_eq_b2(0);\nHistory h_eqz1_l(0);\nHistory h_eqz1_r(0);\nHistory h_eqz1r_l(0);\nHistory h_eqz1r_r(0);\nHistory h_eqz2_l(0);\nHistory h_eqz2_r(0);\nHistory h_eqz2r_l(0);\nHistory h_eqz2r_r(0);\nHistory h_fb_l(0);\nHistory h_fb_r(0);\nHistory h_g_aa(0);\nHistory h_g_dc(0);\nHistory h_g_de(0);\nHistory h_g_hc(0);\nHistory h_g_lc0(0);\nHistory h_g_lc1(0);\nHistory h_g_lc2(0);\nHistory h_g_lc6(0);\nHistory h_g_pre(0);\nHistory h_g_tone(0);\nHistory h_g_w(0);\nHistory h_gnt(0);\nHistory h_hbase(0);\nHistory h_hc_done(0);\nHistory h_hcs_l(0);\nHistory h_hcs_r(0);\nHistory h_hcsr_l(0);\nHistory h_hcsr_r(0);\nHistory h_hpos(0);\nHistory h_hshape(0);\nHistory h_hst(0);\nHistory h_ia1_l(0);\nHistory h_ia1_r(0);\nHistory h_ia2_l(0);\nHistory h_ia2_r(0);\nHistory h_ib1_l(0);\nHistory h_ib1_r(0);\nHistory h_ib1r_l(0);\nHistory h_ib1r_r(0);\nHistory h_ib2_l(0);\nHistory h_ib2_r(0);\nHistory h_ib2r_l(0);\nHistory h_ib2r_r(0);\nHistory h_init(0);\nHistory h_k_aa1(0);\nHistory h_k_aa2(0);\nHistory h_k_aa3(0);\nHistory h_k_pk(0);\nHistory h_lc0_l(0);\nHistory h_lc0_r(0);\nHistory h_lc0r_l(0);\nHistory h_lc0r_r(0);\nHistory h_lc1_l(0);\nHistory h_lc1_r(0);\nHistory h_lc1r_l(0);\nHistory h_lc1r_r(0);\nHistory h_lc2_l(0);\nHistory h_lc2_r(0);\nHistory h_lc2r_l(0);\nHistory h_lc2r_r(0);\nHistory h_lc6_l(0);\nHistory h_lc6_r(0);\nHistory h_lc6r_l(0);\nHistory h_lc6r_r(0);\nHistory h_lc_done(0);\nHistory h_lph(0);\nHistory h_m_s(0);\nHistory h_mtr(0);\nHistory h_na(0);\nHistory h_nb(0);\nHistory h_ns(0);\nHistory h_ph(0);\nHistory h_relk(0);\nHistory h_rka(0);\nHistory h_rkb(0);\nHistory h_rla(0);\nHistory h_rlb(0);\nHistory h_rnd1(0);\nHistory h_rnd2(0);\nHistory h_rnd_t(0);\nHistory h_rw(0);\nHistory h_s_bal_d(0);\nHistory h_s_bal_w(0);\nHistory h_s_byp(0);\nHistory h_s_conv(0);\nHistory h_s_dir(0);\nHistory h_s_drv(0);\nHistory h_s_fb(0);\nHistory h_s_fbi(0);\nHistory h_s_fbs(0);\nHistory h_s_hca(0);\nHistory h_s_hclg(0);\nHistory h_s_hm(0);\nHistory h_s_int(0);\nHistory h_s_lca(0);\nHistory h_s_lclg(0);\nHistory h_s_lcs(0);\nHistory h_s_lvl(0);\nHistory h_s_m0(0);\nHistory h_s_m1(0);\nHistory h_s_m2(0);\nHistory h_s_m3(0);\nHistory h_s_oatt(0);\nHistory h_s_ogain(0);\nHistory h_s_pre(0);\nHistory h_s_ret(0);\nHistory h_s_rg(0);\nHistory h_s_rvf(0);\nHistory h_s_rvo(0);\nHistory h_s_sat(0);\nHistory h_s_so(0);\nHistory h_s_tone(0);\nHistory h_s_trim(0);\nHistory h_s_w1(0);\nHistory h_s_width(0);\nHistory h_sr(0);\nHistory h_st_dc_l(0);\nHistory h_st_dc_r(0);\nHistory h_st_de_l(0);\nHistory h_st_de_r(0);\nHistory h_st_der_l(0);\nHistory h_st_der_r(0);\nHistory h_st_pre_l(0);\nHistory h_st_pre_r(0);\nHistory h_st_tone_l(0);\nHistory h_st_tone_r(0);\nHistory h_w(0);\nHistory h_xdir(0);\nHistory h_xf(0);\nHistory h_xp_l(0);\nHistory h_xp_r(0);\n\n// ---------------------------------------------------- frame setup\nsr = samplerate;\ninv_sr = 1 / sr;\nv_tmp = 0;\nk15 = 1 - exp(-1 / (0.015 * sr));   // 15 ms parameter smoothing\nk5 = 1 - exp(-1 / (0.005 * sr));\nk30 = 1 - exp(-1 / (0.03 * sr));\n\n// cached coefficients (recomputed only when the host rate changes)\ng_pre = h_g_pre; g_de = h_g_de; g_aa = h_g_aa; k_aa1 = h_k_aa1; k_aa2 = h_k_aa2; k_aa3 = h_k_aa3;\ng_dc = h_g_dc; g_tone = h_g_tone; k_pk = h_k_pk;\neq_b0 = h_eq_b0; eq_b1 = h_eq_b1; eq_b2 = h_eq_b2; eq_a1 = h_eq_a1; eq_a2 = h_eq_a2;\nv_g = 0; hf_fa = 0; hf_f0 = 0; hf_gdb = 0; hf_q = 0; eq_a = 0; eq_w = 0; eq_al = 0; eq_n = 0;\nif (sr != h_sr) {\n    v_g = tan(pi * 10610 / sr);  g_pre = v_g / (1 + v_g);     // pre-emph pole 15 us\n    v_g = tan(pi * 3183 / sr);   g_de = v_g / (1 + v_g);      // de-emph pole 50 us\n    hf_fa = 22000; hf_f0 = 15000; hf_gdb = 0; hf_q = 0.7;\n    if (sr < 46050.0) {\n        hf_fa = 23941.000; hf_f0 = 17986.118; hf_gdb = 4.1149; hf_q = 0.2000;\n    }\n    else if (sr < 68100.0) {\n        hf_fa = 23941.000; hf_f0 = 16877.142; hf_gdb = 2.1741; hf_q = 0.2875;\n    }\n    else if (sr < 92100.0) {\n        hf_fa = 23941.000; hf_f0 = 30822.785; hf_gdb = 0.8670; hf_q = 0.2000;\n    }\n    else if (sr < 136200.0) {\n        hf_fa = 23941.000; hf_f0 = 10095.546; hf_gdb = 0.1992; hf_q = 0.5165;\n    }\n    else if (sr < 184200.0) {\n        hf_fa = 23941.000; hf_f0 = 64365.835; hf_gdb = 0.4918; hf_q = 0.2000;\n    }\n    else {\n        hf_fa = 23941.000; hf_f0 = 45098.954; hf_gdb = -0.6105; hf_q = 0.2000;\n    }\n    // RBJ peaking EQ: compensates the host-rate interpolation/averaging droop\n    eq_a = pow(10, hf_gdb * 0.025);\n    eq_w = 2 * pi * min(hf_f0, 0.49 * sr) / sr;\n    eq_al = sin(eq_w) / (2 * hf_q);\n    eq_n = 1 / (1 + eq_al / eq_a);\n    eq_b0 = (1 + eq_al * eq_a) * eq_n;\n    eq_b1 = -2 * cos(eq_w) * eq_n;\n    eq_b2 = (1 - eq_al * eq_a) * eq_n;\n    eq_a1 = eq_b1;\n    eq_a2 = (1 - eq_al / eq_a) * eq_n;\n    v_g = tan(pi * min(hf_fa, 0.45 * sr) / sr);  g_aa = v_g;   // AA / reconstruction 2-pole\n    k_aa1 = 1 / (1 + v_g * (v_g + 1.41421356));\n    k_aa2 = v_g * k_aa1;\n    k_aa3 = v_g * k_aa2;\n    v_g = tan(pi * 5 / sr);      g_dc = v_g / (1 + v_g);      // 5 Hz DC block in loop\n    v_g = tan(pi * 800 / sr);    g_tone = v_g / (1 + v_g);\n    k_pk = exp(-1 / (0.3 * sr));                              // meter release\n}\nv_g = 0;\n\ns_rg = h_s_rg;\ns_w1 = h_s_w1;\ns_lvl = h_s_lvl;\ns_pre = h_s_pre;\ns_drv = h_s_drv;\ns_tone = h_s_tone;\ns_trim = h_s_trim;\ns_fb = h_s_fb;\ns_fbs = h_s_fbs;\ns_int = h_s_int;\ns_bal_d = h_s_bal_d;\ns_bal_w = h_s_bal_w;\ns_so = h_s_so;\ns_byp = h_s_byp;\ns_sat = h_s_sat;\ns_conv = h_s_conv;\ns_lcs = h_s_lcs;\ns_lca = h_s_lca;\ns_hca = h_s_hca;\ns_lclg = h_s_lclg;\ns_hclg = h_s_hclg;\ns_oatt = h_s_oatt;\ns_ogain = h_s_ogain;\ns_width = h_s_width;\ns_dir = h_s_dir;\ns_m0 = h_s_m0;\ns_m1 = h_s_m1;\ns_m2 = h_s_m2;\ns_m3 = h_s_m3;\ns_hm = h_s_hm;\ns_fbi = h_s_fbi;\ns_ret = h_s_ret;\ns_rvo = h_s_rvo;\ns_rvf = h_s_rvf;\n\n// ----------------------------------------------- parameter targets\nt_rg = 1;\nt_w1 = 0;\nif (p_in_range < 0.5) {\n    t_rg = 5.011872;   // -30 range: x10 Hi-Z amp, then same pad as -10\n    t_w1 = 1;\n}\nelse if (p_in_range < 1.5) {\n    t_rg = 5.011872;   // -10 range: +14 dB\n}\nt_lvl = (p_in_level * 0.2) * (p_in_level * 0.2);   // LEVEL: 5 -> 0 dB, 10 -> +12 dB (approx. taper)\nt_drv = pow(10, p_drive * 0.05);\nt_trim = pow(10, p_pre_trim * 0.05);\nif (p_pre_comp > 0.5) {\n    t_trim = t_trim / t_drv;\n}\nt_fbs = 1;\nif (p_fb_inv > 0.5) {\n    t_fbs = -1;\n}\n// v1.0.2-rc4: regeneration route. INT: internal loop only (identical to rc3).\n// EXT: the loop leaves on outs 6/7 (device outputs 3/4) and only the return (device inputs 3/4)\n// is regenerated. BOTH: internal loop plus the return.\nt_fbi = 1;\nt_ret = 0;\nif (p_fb_route > 0.5) {\n    t_ret = p_return * 0.142857143;\n}\nif (p_fb_route > 0.5 && p_fb_route < 1.5) {\n    t_fbi = 0;\n}\nt_so = 1;\nif (p_out_inv > 0.5) {\n    t_so = -1;\n}\n// REVERSE: which path takes the reversed tap. Output reversed = every echo heard backwards;\n// feedback reversed = the direction flips on every pass through the loop.\nt_rvo = 0;\nt_rvf = 0;\nif (p_reverse > 0.5 && p_reverse < 1.5) {\n    t_rvo = 1;     // REV\n}\nelse if (p_reverse > 1.5 && p_reverse < 2.5) {\n    t_rvf = 1;     // ALT: forward first\n}\nelse if (p_reverse > 2.5) {\n    t_rvo = 1;     // ALT R: reversed first\n    t_rvf = 1;\n}\nt_bd = min(1, (10 - p_balance) * 0.2);\nt_bw = min(1, p_balance * 0.2);\nt_dir = 1;\nif (p_wet_only > 0.5) {\n    t_bd = 0;\n    t_dir = 0;\n}\nt_byp = 0;\nif (p_bypass > 0.5) {\n    t_byp = 1;\n    t_bd = 1;\n    t_bw = 0;\n    t_dir = 1;\n}\nt_oatt = 1;\nif (p_out_range < 0.5) {\n    t_oatt = 0.063096;   // -20 dBm: -24 dB re +4\n}\nelse if (p_out_range < 1.5) {\n    t_oatt = 0.199526;   // -10 dBm: -14 dB re +4\n}\nt_lca = 0;\nt_lclg = s_lclg;\nif (t_lclg < 1) {\n    t_lclg = 6.965784;\n}\nif (p_lowcut > 2.5) {\n    t_lca = 1;\n    t_lclg = 8.965784;   // log2(500)\n}\nelse if (p_lowcut > 1.5) {\n    t_lca = 1;\n    t_lclg = 7.965784;   // log2(250)\n}\nelse if (p_lowcut > 0.5) {\n    t_lca = 1;\n    t_lclg = 6.965784;   // log2(125)\n}\nt_hca = 0;\nt_hclg = s_hclg;\nif (t_hclg < 1) {\n    t_hclg = 12.965784;\n}\nif (p_highcut > 2.5) {\n    t_hca = 1;\n    t_hclg = 10.965784;  // log2(2000)\n}\nelse if (p_highcut > 1.5) {\n    t_hca = 1;\n    t_hclg = 11.965784;  // log2(4000)\n}\nelse if (p_highcut > 0.5) {\n    t_hca = 1;\n    t_hclg = 12.965784;  // log2(8000)\n}\nif (s_lclg < 1) {\n    s_lclg = t_lclg;      // first frame: jump to the selected position\n    s_hclg = t_hclg;\n}\nt_m0 = 0; t_m1 = 0; t_m2 = 0; t_m3 = 0;\nif (p_out_mode > 2.5) {\n    t_m3 = 1;\n}\nelse if (p_out_mode > 1.5) {\n    t_m2 = 1;\n}\nelse if (p_out_mode > 0.5) {\n    t_m1 = 1;\n}\nelse {\n    t_m0 = 1;\n}\n\n// first frame after load: start at the targets (no ramps on load)\nif (h_init < 0.5) {\n    s_rg = t_rg;\n    s_w1 = t_w1;\n    s_lvl = t_lvl;\n    s_pre = p_pre_on;\n    s_drv = t_drv;\n    s_tone = p_tone;\n    s_trim = t_trim;\n    s_fb = p_feedback * 0.142857143;\n    s_int = p_intensity * 0.1;\n    s_bal_d = t_bd;\n    s_bal_w = t_bw;\n    s_sat = p_loop_sat;\n    s_conv = p_converter;\n    s_lcs = p_lc_slope;\n    s_oatt = t_oatt;\n    s_ogain = pow(10, p_out_gain * 0.05);\n    s_width = p_width;\n    s_dir = t_dir;\n    s_m0 = t_m0;\n    s_m1 = t_m1;\n    s_m2 = t_m2;\n    s_m3 = t_m3;\n    s_fbs = t_fbs;\n    s_so = t_so;\n    s_byp = t_byp;\n    s_lca = t_lca;\n    s_hca = t_hca;\n    s_fbi = t_fbi;\n    s_ret = t_ret;\n    s_rvo = t_rvo;\n    s_rvf = t_rvf;\n}\n// ------------------------------------------------------- smoothing\ns_rg = s_rg + (t_rg - s_rg) * k15;\ns_w1 = s_w1 + (t_w1 - s_w1) * k15;\ns_lvl = s_lvl + (t_lvl - s_lvl) * k15;\ns_pre = s_pre + (p_pre_on - s_pre) * k15;\ns_drv = s_drv + (t_drv - s_drv) * k15;\ns_tone = s_tone + (p_tone - s_tone) * k15;\ns_trim = s_trim + (t_trim - s_trim) * k15;\ns_fb = s_fb + (p_feedback * 0.142857143 - s_fb) * k15;\ns_int = s_int + (p_intensity * 0.1 - s_int) * k15;\ns_bal_d = s_bal_d + (t_bd - s_bal_d) * k15;\ns_bal_w = s_bal_w + (t_bw - s_bal_w) * k15;\ns_sat = s_sat + (p_loop_sat - s_sat) * k15;\ns_conv = s_conv + (p_converter - s_conv) * k15;\ns_lcs = s_lcs + (p_lc_slope - s_lcs) * k15;\ns_oatt = s_oatt + (t_oatt - s_oatt) * k15;\ns_ogain = s_ogain + (pow(10, p_out_gain * 0.05) - s_ogain) * k15;\ns_width = s_width + (p_width - s_width) * k15;\ns_dir = s_dir + (t_dir - s_dir) * k15;\ns_m0 = s_m0 + (t_m0 - s_m0) * k15;\ns_m1 = s_m1 + (t_m1 - s_m1) * k15;\ns_m2 = s_m2 + (t_m2 - s_m2) * k15;\ns_m3 = s_m3 + (t_m3 - s_m3) * k15;\ns_fbi = s_fbi + (t_fbi - s_fbi) * k15;\ns_ret = s_ret + (t_ret - s_ret) * k15;\ns_fbs = s_fbs + (t_fbs - s_fbs) * k5;\ns_so = s_so + (t_so - s_so) * k5;\ns_byp = s_byp + (t_byp - s_byp) * k5;\ns_lca = s_lca + (t_lca - s_lca) * k5;\ns_hca = s_hca + (t_hca - s_hca) * k5;\ns_lclg = s_lclg + (t_lclg - s_lclg) * k30;\ns_hclg = s_hclg + (t_hclg - s_hclg) * k30;\n\n// switched-filter coefficients: recomputed only while a switch is moving\ng_lc0 = h_g_lc0; g_lc1 = h_g_lc1; g_lc2 = h_g_lc2; g_lc6 = h_g_lc6; g_hc = h_g_hc;\nif (abs(s_lclg - h_lc_done) > 0.00001 || sr != h_sr) {\n    v_g = pow(2, s_lclg);\n    g_lc6 = tan(pi * min(v_g, 0.45 * sr) * inv_sr);  g_lc6 = g_lc6 / (1 + g_lc6);\n    v_g = v_g * 1.25;   // half-order (-3 dB/oct) approximation: 3 pole/zero pairs, 2 oct apart\n    g_lc0 = tan(pi * min(v_g, 0.45 * sr) * inv_sr);  g_lc0 = g_lc0 / (1 + g_lc0);\n    g_lc1 = tan(pi * v_g * 0.25 * inv_sr);  g_lc1 = g_lc1 / (1 + g_lc1);\n    g_lc2 = tan(pi * v_g * 0.0625 * inv_sr);  g_lc2 = g_lc2 / (1 + g_lc2);\n}\nif (abs(s_hclg - h_hc_done) > 0.00001 || sr != h_sr) {\n    v_g = pow(2, s_hclg);\n    g_hc = tan(pi * min(v_g, 0.45 * sr) * inv_sr);  g_hc = g_hc / (1 + g_hc);\n}\nv_g = 0;\n// REVERSE: 25 ms linear ramps that land exactly on 0 / 1, smoothstep-weighted\nrv_step = inv_sr / 0.025;\ns_rvo = s_rvo + clamp(t_rvo - s_rvo, -rv_step, rv_step);\ns_rvf = s_rvf + clamp(t_rvf - s_rvf, -rv_step, rv_step);\ng_rvo = s_rvo * s_rvo * (3 - 2 * s_rvo);\ng_rvf = s_rvf * s_rvf * (3 - 2 * s_rvf);\nrv_on = 0;\nif (s_rvo > 0 || s_rvf > 0 || t_rvo > 0.5 || t_rvf > 0.5) {\n    rv_on = 1;\n}\n\n// ============================================================ INPUT\nin_l = clamp(fixnan(in1), -1000, 1000);   // v1.0.2: NaN -> 0, +-inf -> +-1000 (+60 dBFS); valid audio unchanged\nin_r = clamp(fixnan(in2), -1000, 1000);\nret_l = clamp(fixnan(in3), -1000, 1000);   // v1.0.2-rc4: EXT loop return (device inputs 3/4)\nret_r = clamp(fixnan(in4), -1000, 1000);\n// rc5: CAL. Fade the external loop out (20 ms), wait (30 ms), send one click on outputs 3/4, time its\n// arrival on inputs 3/4 (max 500 ms), fade back in. Result (ms, or -1 = not found) on out8 for 100 ms.\ncal_st = h_cal_st; cal_n = h_cal_n; cal_m = h_cal_m; cal_env = h_cal_env; cal_res = h_cal_res; cal_hold = h_cal_hold;\ncal_prev = p_cal;\nif (p_cal > 0.5 && h_cal_prev < 0.5 && cal_st < 0.5 && p_fb_route > 0.5) {\n    cal_st = 1;\n    cal_n = 0;\n}\ncal_click = 0;\ncal_a = abs(ret_l) + abs(ret_r);\nif (cal_st > 0.5) {\n    cal_n = cal_n + 1;\n}\nif (cal_st > 0.5 && cal_st < 1.5) {\n    cal_m = min(cal_m + 50 / sr, 1);\n    if (cal_n > 0.05 * sr) {\n        cal_st = 2;\n        cal_n = 0;\n        cal_env = 0;\n    }\n}\nelse if (cal_st > 1.5 && cal_st < 2.5) {\n    if (cal_n < 1.5) {\n        cal_click = 0.9;\n    }\n    if (cal_n > 1.5 && cal_a > 0.25 && cal_a > 4 * cal_env) {\n        cal_res = (cal_n - 1) * 1000 / sr;\n        cal_hold = 0.1 * sr;\n        cal_st = 3;\n        cal_n = 0;\n    }\n    else if (cal_n > 0.5 * sr) {\n        cal_res = -1;\n        cal_hold = 0.1 * sr;\n        cal_st = 3;\n        cal_n = 0;\n    }\n    cal_env = cal_env + (cal_a - cal_env) * 0.002;\n}\nelse if (cal_st > 2.5) {\n    cal_m = max(cal_m - 50 / sr, 0);\n    if (cal_m < 0.0000001) {\n        cal_m = 0;\n        cal_st = 0;\n    }\n}\ncal_out = -2;\nif (cal_hold > 0.5) {\n    cal_out = cal_res;\n    cal_hold = cal_hold - 1;\n}\ncal_live = 1 - cal_m;\nx_m = (in_l + in_r) * 0.5;\nx_l = x_m;\nx_r = x_m;\nif (s_m3 > 0.000001) {\n    x_l = x_m + (in_l - x_m) * s_m3;     // TRUE STEREO (modern) keeps L/R separate\n    x_r = x_m + (in_r - x_m) * s_m3;\n}\nst_tone_l = h_st_tone_l; st_tone_r = h_st_tone_r;\n\n// -- channel l : attenuator / Hi-Z amp / LEVEL / op-amp stage (approximation)\ns1c_l = x_l + (((x_l * 10) / pow(1 + pow(abs(x_l * 10), 5), 0.2)) - x_l) * s_w1;          // -30 range: x10 Hi-Z amp with rail clip\ns1l_l = x_l * (1 + 9 * s_w1);                // same, linear (character off)\nv_tmp = (s1c_l * s_rg * s_lvl - st_tone_l) * g_tone;\ntl_l = v_tmp + st_tone_l;\nst_tone_l = fixdenorm(tl_l + v_tmp);\nth_l = s1c_l * s_rg * s_lvl - tl_l;\ntt_l = tl_l * pow(2, -s_tone) + th_l * pow(2, s_tone);     // +-6 dB tilt\ndv_l = tt_l * s_drv;\nac_l = ((dv_l) / pow(1 + pow(abs(dv_l), 5), 0.2)) * s_trim;                          // amp B rail clip (+17 dB over nominal at LEVEL 5)\nal_l = s1l_l * s_rg * s_lvl;\na_l = al_l + (ac_l - al_l) * s_pre;       // preamp output = DIRECT signal\n\n\n// -- channel r : attenuator / Hi-Z amp / LEVEL / op-amp stage (approximation)\ns1c_r = x_r + (((x_r * 10) / pow(1 + pow(abs(x_r * 10), 5), 0.2)) - x_r) * s_w1;          // -30 range: x10 Hi-Z amp with rail clip\ns1l_r = x_r * (1 + 9 * s_w1);                // same, linear (character off)\nv_tmp = (s1c_r * s_rg * s_lvl - st_tone_r) * g_tone;\ntl_r = v_tmp + st_tone_r;\nst_tone_r = fixdenorm(tl_r + v_tmp);\nth_r = s1c_r * s_rg * s_lvl - tl_r;\ntt_r = tl_r * pow(2, -s_tone) + th_r * pow(2, s_tone);     // +-6 dB tilt\ndv_r = tt_r * s_drv;\nac_r = ((dv_r) / pow(1 + pow(abs(dv_r), 5), 0.2)) * s_trim;                          // amp B rail clip (+17 dB over nominal at LEVEL 5)\nal_r = s1l_r * s_rg * s_lvl;\na_r = al_r + (ac_r - al_r) * s_pre;       // preamp output = DIRECT signal\n\n\n// ======================================================= MODULATION\nlph = h_lph; rnd_t = h_rnd_t; rnd1 = h_rnd1; rnd2 = h_rnd2; envf = h_envf; m_s = h_m_s;\nf_hz = 0.1 * pow(150, p_frequency * 0.1);   // 0 -> 0.1 Hz (10 s), 10 -> 15 Hz\nlph = lph + f_hz * inv_sr;\nlwrap = 0;\nif (lph >= 1) {\n    lph = lph - 1;\n    lwrap = 1;\n}\ntri = 1 - abs(2 * lph - 1);\nm_tri = (sqrt(tri * tri + 0.0144) - 0.12) * 1.127172;   // sharp peak, rounded trough (SM Fig.3)\nm_sq = 0;\nif (lph >= 0.5) {\n    m_sq = 1;\n}\nif (lwrap > 0.5) {\n    rnd_t = noise() * 0.5 + 0.5;    // new random level once per LFO cycle\n}\nk_rnd = 1 - exp(-4 * f_hz * inv_sr);   // 'integrated' (smoothed) S&H\nrnd1 = rnd1 + (rnd_t - rnd1) * k_rnd;\nrnd2 = fixdenorm(rnd2 + (rnd1 - rnd2) * k_rnd);\ne_in = max(abs(a_l), abs(a_r)) * 5.011872 * pow(10, p_env_sens * 0.05);\nif (e_in > envf) {\n    envf = envf + (e_in - envf) * (1 - exp(-1 / (0.002 * sr)));\n}\nelse {\n    envf = fixdenorm(envf + (e_in - envf) * (1 - exp(-1 / (p_env_rel * 0.001 * sr))));\n}\nm_env = clamp(envf * 1.412538, 0, 1);    // nominal level (meter 0 dB) = full swing\nm_raw = m_tri;\nif (p_waveform > 2.5) {\n    m_raw = m_env;\n}\nelse if (p_waveform > 1.5) {\n    m_raw = rnd2;\n}\nelse if (p_waveform > 0.5) {\n    m_raw = m_sq;\n}\nm_s = m_s + (m_raw - m_s) * (1 - exp(-1 / (0.0007 * sr)));   // VCO control lag\nfv = 64000 * (1 + s_int * m_s);    // memory clock: 64 kHz nominal, up to 2:1 (delay -> 50%)\n\n// ======================================================= DELAY TIME\nms = p_time_ms;\nif (p_time_mode < 0.5) {\n    ms = floor(p_time_ms + 0.5);     // authentic 1 ms steps\n}\nbeats = 4;\nif (p_sync > 0.5) {\n    if (p_division < 0.5) {\n        beats = 0.125000000;\n    }\n    else if (p_division < 1.5) {\n        beats = 0.250000000;\n    }\n    else if (p_division < 2.5) {\n        beats = 0.333333333;\n    }\n    else if (p_division < 3.5) {\n        beats = 0.500000000;\n    }\n    else if (p_division < 4.5) {\n        beats = 0.666666667;\n    }\n    else if (p_division < 5.5) {\n        beats = 0.750000000;\n    }\n    else if (p_division < 6.5) {\n        beats = 1.000000000;\n    }\n    else if (p_division < 7.5) {\n        beats = 1.333333333;\n    }\n    else if (p_division < 8.5) {\n        beats = 1.500000000;\n    }\n    else if (p_division < 9.5) {\n        beats = 2.000000000;\n    }\n    if (p_division > 10.5 && p_division < 11.5) {\n        beats = 0.166666667;     // rc5: 1/16T\n    }\n    if (p_division > 11.5) {\n        beats = 0.083333333;     // rc5: 1/32T\n    }\n    ms = clamp(60000 / max(p_tempo, 20) * beats, 0, 1023);\n}\nms_disp = ms;\n// rc5: LOOP COMP. In EXT the external pass adds Live's routing latency; shorten the internal delay\n// by the same amount so the repeat period equals TIME. Not applied in INT or BOTH.\nif (p_loop_comp > 0 && p_fb_route > 0.5 && p_fb_route < 1.5) {\n    ms = max(ms - p_loop_comp, 1);\n}\nn_tgt = fixnan(clamp(ms * 64, 0, 65472));\nna = h_na; nb = h_nb; xf = h_xf; xdir = h_xdir; ns = h_ns;\nact = 0;\nxstep = 0;\nif (p_time_glide > 0.5) {\n    ns = ns + (n_tgt - ns) * (1 - exp(-1 / (0.12 * sr)));\n    na = ns;\n    nb = ns;\n    xf = 0;\n    xdir = 0;\n}\nelse {\n    if (abs(xf - xdir) < 0.0000001) {\n        act = na;\n        if (xdir > 0.5) {\n            act = nb;\n        }\n        if (abs(n_tgt - act) > 0.001) {\n            if (xdir > 0.5) {\n                na = n_tgt;\n                xdir = 0;\n            }\n            else {\n                nb = n_tgt;\n                xdir = 1;\n            }\n        }\n    }\n    xstep = inv_sr / 0.025;     // 25 ms equal-power crossfade between taps\n    xf = xf + clamp(xdir - xf, -xstep, xstep);\n    ns = na + (nb - na) * xf;\n}\nrv_len = clamp(floor(ns + 0.5), 128, 65536);   // reverse window = the current delay\ng_a = cos(xf * 1.570796327);\ng_b = sin(xf * 1.570796327);\n\n// ============================================================= HOLD\n// v1.0.2: state machine  hst 0 = normal, 1 = held, 2 = releasing (loop audible),\n// 3 = releasing, loop faded early because the HOLD reader would reach new audio (delays > ~944 ms).\n// Engage is unchanged from v1.0.1. On release the HOLD loop keeps playing while the\n// writer restarts just behind the HOLD reader; once the normal tap reads only newly\n// written memory (one delay time later) the loop crossfades out over 10 ms.\nw = h_w; hpos = h_hpos; hbase = h_hbase; hst = h_hst; relk = h_relk; g_w = h_g_w; gnt = h_gnt;\nhshape = h_hshape;   // 1 while a release fade (or its reversal) is in progress: smoothstep weighting\nif (h_init < 0.5) {\n    g_w = 1;\n    gnt = 1;\n}\nhold_on = 0;\nn_dom = 0;\nhr0 = 0;\nif (p_hold > 0.5) {\n    hold_on = 1;\n}\nif (hold_on > 0.5 && hst < 0.5) {\n    if (s_hm > 0.000001) {\n        hst = 1;     // re-engaged while the previous loop is still audible: keep it, no jump\n    }\n    else {\n        hbase = w;   // loop = the last 1008 ms written; playback continues from the current tap\n        n_dom = na;\n        if (g_b > g_a) {\n            n_dom = nb;\n        }\n        hpos = clamp(floor(64512 - n_dom + 0.5), 0, 64511);\n        g_w = 0;     // memory writes stop immediately (as v1.0.1)\n        hst = 1;\n    }\n}\nelse if (hold_on > 0.5 && hst > 1.5) {\n    hst = 1;         // re-engaged during the release window: keep the loop, fade the writes out\n}\nelse if (hold_on < 0.5 && hst > 0.5 && hst < 1.5 && s_hm >= 1) {\n    hr0 = hbase - 64512 + hpos - 1;   // writer restarts one word behind the HOLD reader\n    if (hr0 < 0) {\n        hr0 = hr0 + 65536;\n    }\n    w = hr0;\n    relk = 0;\n    hst = 2;\n}\nhm_t = 0;\nhm_step = inv_sr / 0.010;      // release: 10 ms crossfade back to the normal tap\nif (hst > 0.5 && hst < 2.5) {\n    hm_t = 1;\n    hm_step = inv_sr / 0.005;  // engage: 5 ms (as v1.0.1)\n}\ns_hm = s_hm + clamp(hm_t - s_hm, -hm_step, hm_step);\nif (s_hm >= 1 || s_hm <= 0) {\n    hshape = 0;\n}\nhm_w = s_hm;                   // engage / held: linear (as v1.0.1)\nif (hshape > 0.5) {\n    hm_w = s_hm * s_hm * (3 - 2 * s_hm);   // release fade: smoothstep, no slope corners; stays\n}                                          // smoothstep if HOLD is pressed again mid-fade (continuous)\n// normal-tap gain: muted while releasing until the tap reads only new audio\ngnt_t = 1;\nif (hst > 1.5) {\n    gnt_t = 0;\n}\nif (gnt_t > 0.5 && s_hm >= 1) {\n    gnt = 1;                   // loop still fully audible: switch silently\n}\ngnt = gnt + clamp(gnt_t - gnt, -inv_sr / 0.010, inv_sr / 0.010);\ngnt_w = gnt * gnt * (3 - 2 * gnt);\nw_tgt = 1;\nif (hst > 0.5 && hst < 1.5) {\n    w_tgt = 0;\n}\n\n// ======================================== FEEDBACK SUM -> A/D chain\nfb_l = h_fb_l; fb_r = h_fb_r;\nst_pre_l = h_st_pre_l; st_pre_r = h_st_pre_r; st_dc_l = h_st_dc_l; st_dc_r = h_st_dc_r;\nia1_l = h_ia1_l; ia2_l = h_ia2_l; ia1_r = h_ia1_r; ia2_r = h_ia2_r;\n\nd_l = (a_l + fb_l) * 5.011872;              // summing amp -> converter scale (meter tap)\ndg_l = d_l * (1 - s_byp);                    // BYPASS grounds the converter input\nv_tmp = (dg_l - st_pre_l) * g_pre;           // pre-emphasis (50/15 us shelf, +10.5 dB HF)\npl_l = v_tmp + st_pre_l;\nst_pre_l = fixdenorm(pl_l + v_tmp);\npe_l = pl_l + 3.333333 * (dg_l - pl_l);\nv3_l = pe_l - ia2_l;                        // anti-alias LPF (2-pole Butterworth)\nv1_l = k_aa1 * ia1_l + k_aa2 * v3_l;\nv2_l = ia2_l + k_aa2 * ia1_l + k_aa3 * v3_l;\nia1_l = fixdenorm(2 * v1_l - ia1_l);\nia2_l = fixdenorm(2 * v2_l - ia2_l);\nv_tmp = (v2_l - st_dc_l) * g_dc;             // 5 Hz DC block (no DC accumulation)\ndcl_l = v_tmp + st_dc_l;\nst_dc_l = fixdenorm(dcl_l + v_tmp);\nxs_l = v2_l - dcl_l;\nxsat_l = 0.98 * ((xs_l * 1.0204) / pow(1 + pow(abs(xs_l * 1.0204), 5), 0.2));\nxc_l = xs_l + (xsat_l - xs_l) * s_sat;    // optional soft loop saturation\n\n\nd_r = (a_r + fb_r) * 5.011872;              // summing amp -> converter scale (meter tap)\ndg_r = d_r * (1 - s_byp);                    // BYPASS grounds the converter input\nv_tmp = (dg_r - st_pre_r) * g_pre;           // pre-emphasis (50/15 us shelf, +10.5 dB HF)\npl_r = v_tmp + st_pre_r;\nst_pre_r = fixdenorm(pl_r + v_tmp);\npe_r = pl_r + 3.333333 * (dg_r - pl_r);\nv3_r = pe_r - ia2_r;                        // anti-alias LPF (2-pole Butterworth)\nv1_r = k_aa1 * ia1_r + k_aa2 * v3_r;\nv2_r = ia2_r + k_aa2 * ia1_r + k_aa3 * v3_r;\nia1_r = fixdenorm(2 * v1_r - ia1_r);\nia2_r = fixdenorm(2 * v2_r - ia2_r);\nv_tmp = (v2_r - st_dc_r) * g_dc;             // 5 Hz DC block (no DC accumulation)\ndcl_r = v_tmp + st_dc_r;\nst_dc_r = fixdenorm(dcl_r + v_tmp);\nxs_r = v2_r - dcl_r;\nxsat_r = 0.98 * ((xs_r * 1.0204) / pow(1 + pow(abs(xs_r * 1.0204), 5), 0.2));\nxc_r = xs_r + (xsat_r - xs_r) * s_sat;    // optional soft loop saturation\n\npk = max(abs(d_l), abs(d_r));\nmtr = h_mtr * k_pk;\nif (pk > mtr) {\n    mtr = pk;\n}\n\n// ================================== MEMORY CLOCK EMULATION (ticks)\n// The 64K-word memory runs on its own (modulated) clock. Every tick\n// converts the interpolated input, writes one word and reads the taps;\n// the DAC output is a zero-order hold, integrated over the host sample.\nph = h_ph;\nxp_l = h_xp_l; xp_r = h_xp_r;\ndac_l = h_dac_l; dac_r = h_dac_r;\ninc = fv * inv_sr;\ntdt = 1 / inc;\ntt = (1 - ph) * tdt;\ntl = 0;\nnt = 0;\nacc_l = 0; acc_r = 0;\nlsb_q = 1 - s_conv;\nrw = h_rw; rka = h_rka; rkb = h_rkb; rla = h_rla; rlb = h_rlb;\ndacr_l = h_dacr_l; dacr_r = h_dacr_r;\naccr_l = 0; accr_r = 0;\nif (rla < 127.5) {\n    rla = rv_len;\n    rka = 0;\n}\nif (rlb < 127.5) {\n    rlb = rv_len;\n    rkb = floor(rv_len * 0.5);   // second reader half a window later: the two Hann windows sum to 1\n}\nxi_l = 0;\nxi_r = 0;\nq_l = 0;\nq_r = 0;\nra = 0;\nia = 0;\nfa = 0;\nib = 0;\nrb = 0;\njb = 0;\nfb2 = 0;\njb2 = 0;\nta_l = 0;\nta_r = 0;\ntb_l = 0;\ntb_r = 0;\nhr = 0;\nhr2 = 0;\nhg = 0;\nhv_l = 0;\nhv_r = 0;\nwl = 0;\nwr = 0;\nia2 = 0;\nq13_l = 0;\nq13_r = 0;\ng_ws = 0;\nrq_l = 0;\nrq_r = 0;\nrra = 0;\nrrb = 0;\nrga = 0;\nrgb = 0;\nrgs = 0;\nrvl = 0;\nrvr = 0;\nwhile (tt < 1 && nt < 8) {\n    acc_l = acc_l + dac_l * (tt - tl);\n    acc_r = acc_r + dac_r * (tt - tl);\n    accr_l = accr_l + dacr_l * (tt - tl);\n    accr_r = accr_r + dacr_r * (tt - tl);\n    xi_l = clamp(xp_l + (xc_l - xp_l) * tt, -1, 0.999755859);   // converter full scale\n    if (abs(xi_l) < 0.5) {\n        q13_l = floor(xi_l * 4096 + 0.5) * 0.000244140625;   // gain-ranged: +6 dB before the 12-bit converter\n    }\n    else {\n        q13_l = floor(xi_l * 2048 + 0.5) * 0.00048828125;    // 12-bit\n    }\n    q_l = xi_l + (q13_l - xi_l) * lsb_q;\n    xi_r = clamp(xp_r + (xc_r - xp_r) * tt, -1, 0.999755859);   // converter full scale\n    if (abs(xi_r) < 0.5) {\n        q13_r = floor(xi_r * 4096 + 0.5) * 0.000244140625;   // gain-ranged: +6 dB before the 12-bit converter\n    }\n    else {\n        q13_r = floor(xi_r * 2048 + 0.5) * 0.00048828125;    // 12-bit\n    }\n    q_r = xi_r + (q13_r - xi_r) * lsb_q;\n    q_l = fixnan(q_l);\n    q_r = fixnan(q_r);\n    rq_l = q_l;\n    rq_r = q_r;\n    if (g_w > 0.000001) {\n        if (g_w < 0.999999) {\n            g_ws = g_w * g_w * (3 - 2 * g_w);   // 4 ms smoothstep write fade (HOLD transitions only)\n            q_l = peek(mem, w, 0) + (q_l - peek(mem, w, 0)) * g_ws;\n            q_r = peek(mem, w, 1) + (q_r - peek(mem, w, 1)) * g_ws;\n            rq_l = peek(rmem, rw, 0) + (rq_l - peek(rmem, rw, 0)) * g_ws;\n            rq_r = peek(rmem, rw, 1) + (rq_r - peek(rmem, rw, 1)) * g_ws;\n        }\n        poke(mem, q_l, w, 0);\n        poke(mem, q_r, w, 1);\n        poke(rmem, rq_l, rw, 0);    // reverse memory records exactly what the main memory records\n        poke(rmem, rq_r, rw, 1);\n    }\n    rra = rw - 2 * rka;              // reverse readers move backwards: age 2k, window centre = delay\n    if (rra < 0) {\n        rra = rra + 131072;\n    }\n    rrb = rw - 2 * rkb;\n    if (rrb < 0) {\n        rrb = rrb + 131072;\n    }\n    if (rv_on > 0.5) {\n        rga = 0.5 - 0.5 * cos(6.283185307 * rka / rla);\n        rgb = 0.5 - 0.5 * cos(6.283185307 * rkb / rlb);\n        rgs = max(rga + rgb, 0.25);   // = 1 while the window length is steady\n        rvl = (peek(rmem, rra, 0) * rga + peek(rmem, rrb, 0) * rgb) / rgs;\n        rvr = (peek(rmem, rra, 1) * rga + peek(rmem, rrb, 1) * rgb) / rgs;\n    }\n    if (g_w > 0.000001) {\n        rka = rka + 1;               // readers advance only while recording (frozen during HOLD)\n        if (rka >= rla) {\n            rka = 0;\n            rla = rv_len;\n        }\n        rkb = rkb + 1;\n        if (rkb >= rlb) {\n            rkb = 0;\n            rlb = rv_len;\n        }\n        rw = rw + 1;\n        if (rw >= 131072) {\n            rw = rw - 131072;\n        }\n    }\n    g_w = g_w + clamp(w_tgt - g_w, -0.00390625, 0.00390625);\n    relk = relk + 1;\n    if (relk > 70000) {\n        relk = 70000;\n    }\n    ra = w - na;\n    if (ra < 0) {\n        ra = ra + 65536;\n    }\n    ia = floor(ra);\n    fa = ra - ia;\n    ia2 = ia + 1;\n    if (ia2 >= 65536) {\n        ia2 = ia2 - 65536;\n    }\n    ta_l = peek(mem, ia, 0) * (1 - fa) + peek(mem, ia2, 0) * fa;\n    ta_r = peek(mem, ia, 1) * (1 - fa) + peek(mem, ia2, 1) * fa;\n    tb_l = ta_l;\n    tb_r = ta_r;\n    if (xf > 0.0000001 && xf < 0.9999999) {\n        rb = w - nb;\n        if (rb < 0) {\n            rb = rb + 65536;\n        }\n        jb = floor(rb);\n        fb2 = rb - jb;\n        jb2 = jb + 1;\n        if (jb2 >= 65536) {\n            jb2 = jb2 - 65536;\n        }\n        tb_l = peek(mem, jb, 0) * (1 - fb2) + peek(mem, jb2, 0) * fb2;\n        tb_r = peek(mem, jb, 1) * (1 - fb2) + peek(mem, jb2, 1) * fb2;\n        wl = ta_l * g_a + tb_l * g_b;\n        wr = ta_r * g_a + tb_r * g_b;\n    }\n    else {\n        wl = ta_l;\n        wr = ta_r;\n        if (xf >= 0.9999999) {\n            rb = w - nb;\n            if (rb < 0) {\n                rb = rb + 65536;\n            }\n            jb = floor(rb);\n            fb2 = rb - jb;\n            jb2 = jb + 1;\n            if (jb2 >= 65536) {\n                jb2 = jb2 - 65536;\n            }\n            wl = peek(mem, jb, 0) * (1 - fb2) + peek(mem, jb2, 0) * fb2;\n            wr = peek(mem, jb, 1) * (1 - fb2) + peek(mem, jb2, 1) * fb2;\n        }\n    }\n    if (gnt_w < 1) {\n        wl = wl * gnt_w;\n        wr = wr * gnt_w;\n        rvl = rvl * gnt_w;\n        rvr = rvr * gnt_w;\n    }\n    if (s_hm > 0.000001) {\n        hr = hbase - 64512 + hpos;\n        if (hr < 0) {\n            hr = hr + 65536;\n        }\n        hv_l = peek(mem, hr, 0);\n        hv_r = peek(mem, hr, 1);\n        if (hpos >= 63488) {\n            hg = (hpos - 63488) * 0.000976562500;   // seam crossfade\n            hr2 = hr - 64512;\n            if (hr2 < 0) {\n                hr2 = hr2 + 65536;\n            }\n            hv_l = hv_l * sqrt(1 - hg) + peek(mem, hr2, 0) * sqrt(hg);\n            hv_r = hv_r * sqrt(1 - hg) + peek(mem, hr2, 1) * sqrt(hg);\n        }\n        wl = wl + (hv_l - wl) * hm_w;\n        wr = wr + (hv_r - wr) * hm_w;\n        rvl = rvl + (hv_l - rvl) * hm_w;   // HOLD plays forwards in every REVERSE mode\n        rvr = rvr + (hv_r - rvr) * hm_w;\n    }\n    dac_l = wl;\n    dac_r = wr;\n    dacr_l = rvl;\n    dacr_r = rvr;\n    w = w + 1;\n    if (w >= 65536) {\n        w = w - 65536;\n    }\n    hpos = hpos + 1;\n    if (hpos >= 64512) {\n        hpos = hpos - 64512;\n    }\n    tl = tt;\n    tt = tt + tdt;\n    nt = nt + 1;\n}\nacc_l = acc_l + dac_l * (1 - tl);\nacc_r = acc_r + dac_r * (1 - tl);\naccr_l = accr_l + dacr_l * (1 - tl);\naccr_r = accr_r + dacr_r * (1 - tl);\nhra = 0;\nif (hst > 1.5) {\n    hra = hbase - 64512 + hpos - w;   // how far the HOLD reader is ahead of the writer\n    if (hra < 0) {\n        hra = hra + 65536;\n    }\n    if (relk >= max(na, nb) + 3) {\n        if (hst < 2.5) {\n            hshape = 1;\n        }\n        hst = 0;     // the normal tap now reads only new audio -> crossfade the loop out\n    }\n    else if (relk + 3072 >= 65536 - hra - 1024 && hst < 2.5) {\n        hshape = 1;\n        hst = 3;     // reader would reach new audio first (delay > ~944 ms): fade the loop out now\n    }\n}\nph = ph + inc - nt;\nif (ph >= 1) {\n    ph = 0.999999;\n}\nif (ph < 0) {\n    ph = 0;\n}\n\n// ===================== D/A -> LPF -> DE-EMPHASIS -> LOW/HIGH filters\nib1_l = h_ib1_l; ib2_l = h_ib2_l; ib1_r = h_ib1_r; ib2_r = h_ib2_r;\nst_de_l = h_st_de_l; st_de_r = h_st_de_r;\neqz1_l = h_eqz1_l; eqz2_l = h_eqz2_l; eqz1_r = h_eqz1_r; eqz2_r = h_eqz2_r;\nlc0_l = h_lc0_l; lc1_l = h_lc1_l; lc2_l = h_lc2_l; lc6_l = h_lc6_l; hcs_l = h_hcs_l;\nlc0_r = h_lc0_r; lc1_r = h_lc1_r; lc2_r = h_lc2_r; lc6_r = h_lc6_r; hcs_r = h_hcs_r;\n\nu3_l = acc_l - ib2_l;                       // reconstruction LPF (2-pole Butterworth)\nu1_l = k_aa1 * ib1_l + k_aa2 * u3_l;\nu2_l = ib2_l + k_aa2 * ib1_l + k_aa3 * u3_l;\nib1_l = fixdenorm(2 * u1_l - ib1_l);\nib2_l = fixdenorm(2 * u2_l - ib2_l);\neqy_l = eq_b0 * u2_l + eqz1_l;                // droop compensation (TDF-II biquad)\neqz1_l = fixdenorm(eq_b1 * u2_l - eq_a1 * eqy_l + eqz2_l);\neqz2_l = fixdenorm(eq_b2 * u2_l - eq_a2 * eqy_l);\nuq_l = u2_l + (eqy_l - u2_l) * p_hf_comp;\nv_tmp = (uq_l - st_de_l) * g_de;             // de-emphasis\ndl_l = v_tmp + st_de_l;\nst_de_l = fixdenorm(dl_l + v_tmp);\ny_l = (dl_l + 0.3 * (uq_l - dl_l)) * 0.199526231;   // back to analog nominal\nv_tmp = (y_l - lc0_l) * g_lc0;               // LOW cut: half-order (-3 dB/oct)\nlp0_l = v_tmp + lc0_l;\nlc0_l = fixdenorm(lp0_l + v_tmp);\nz0_l = (y_l - lp0_l) + 0.5 * lp0_l;\nv_tmp = (z0_l - lc1_l) * g_lc1;\nlp1_l = v_tmp + lc1_l;\nlc1_l = fixdenorm(lp1_l + v_tmp);\nz1_l = (z0_l - lp1_l) + 0.5 * lp1_l;\nv_tmp = (z1_l - lc2_l) * g_lc2;\nlp2_l = v_tmp + lc2_l;\nlc2_l = fixdenorm(lp2_l + v_tmp);\nz2_l = (z1_l - lp2_l) + 0.5 * lp2_l;\nv_tmp = (y_l - lc6_l) * g_lc6;               // LOW cut: alternative first-order (-6 dB/oct)\nlp6_l = v_tmp + lc6_l;\nlc6_l = fixdenorm(lp6_l + v_tmp);\nz6_l = y_l - lp6_l;\nzl_l = z2_l + (z6_l - z2_l) * s_lcs;\nlo_l = y_l + (zl_l - y_l) * s_lca;\nv_tmp = (lo_l - hcs_l) * g_hc;               // HIGH cut: first-order (-6 dB/oct)\nhl_l = v_tmp + hcs_l;\nhcs_l = fixdenorm(hl_l + v_tmp);\nwet_l = lo_l + (hl_l - lo_l) * s_hca;\n\n\nu3_r = acc_r - ib2_r;                       // reconstruction LPF (2-pole Butterworth)\nu1_r = k_aa1 * ib1_r + k_aa2 * u3_r;\nu2_r = ib2_r + k_aa2 * ib1_r + k_aa3 * u3_r;\nib1_r = fixdenorm(2 * u1_r - ib1_r);\nib2_r = fixdenorm(2 * u2_r - ib2_r);\neqy_r = eq_b0 * u2_r + eqz1_r;                // droop compensation (TDF-II biquad)\neqz1_r = fixdenorm(eq_b1 * u2_r - eq_a1 * eqy_r + eqz2_r);\neqz2_r = fixdenorm(eq_b2 * u2_r - eq_a2 * eqy_r);\nuq_r = u2_r + (eqy_r - u2_r) * p_hf_comp;\nv_tmp = (uq_r - st_de_r) * g_de;             // de-emphasis\ndl_r = v_tmp + st_de_r;\nst_de_r = fixdenorm(dl_r + v_tmp);\ny_r = (dl_r + 0.3 * (uq_r - dl_r)) * 0.199526231;   // back to analog nominal\nv_tmp = (y_r - lc0_r) * g_lc0;               // LOW cut: half-order (-3 dB/oct)\nlp0_r = v_tmp + lc0_r;\nlc0_r = fixdenorm(lp0_r + v_tmp);\nz0_r = (y_r - lp0_r) + 0.5 * lp0_r;\nv_tmp = (z0_r - lc1_r) * g_lc1;\nlp1_r = v_tmp + lc1_r;\nlc1_r = fixdenorm(lp1_r + v_tmp);\nz1_r = (z0_r - lp1_r) + 0.5 * lp1_r;\nv_tmp = (z1_r - lc2_r) * g_lc2;\nlp2_r = v_tmp + lc2_r;\nlc2_r = fixdenorm(lp2_r + v_tmp);\nz2_r = (z1_r - lp2_r) + 0.5 * lp2_r;\nv_tmp = (y_r - lc6_r) * g_lc6;               // LOW cut: alternative first-order (-6 dB/oct)\nlp6_r = v_tmp + lc6_r;\nlc6_r = fixdenorm(lp6_r + v_tmp);\nz6_r = y_r - lp6_r;\nzl_r = z2_r + (z6_r - z2_r) * s_lcs;\nlo_r = y_r + (zl_r - y_r) * s_lca;\nv_tmp = (lo_r - hcs_r) * g_hc;               // HIGH cut: first-order (-6 dB/oct)\nhl_r = v_tmp + hcs_r;\nhcs_r = fixdenorm(hl_r + v_tmp);\nwet_r = lo_r + (hl_r - lo_r) * s_hca;\n\nib1r_l = h_ib1r_l; ib2r_l = h_ib2r_l; st_der_l = h_st_der_l; eqz1r_l = h_eqz1r_l; eqz2r_l = h_eqz2r_l; lc0r_l = h_lc0r_l; lc1r_l = h_lc1r_l; lc2r_l = h_lc2r_l; lc6r_l = h_lc6r_l; hcsr_l = h_hcsr_l;\nib1r_r = h_ib1r_r; ib2r_r = h_ib2r_r; st_der_r = h_st_der_r; eqz1r_r = h_eqz1r_r; eqz2r_r = h_eqz2r_r; lc0r_r = h_lc0r_r; lc1r_r = h_lc1r_r; lc2r_r = h_lc2r_r; lc6r_r = h_lc6r_r; hcsr_r = h_hcsr_r;\n// ----- REVERSE tap: own D/A chain, computed only while a REVERSE mode is (fading) on\ndlr_l = 0; dlr_r = 0; eqyr_l = 0; eqyr_r = 0; hlr_l = 0; hlr_r = 0; lor_l = 0; lor_r = 0; lp0r_l = 0; lp0r_r = 0; lp1r_l = 0; lp1r_r = 0; lp2r_l = 0; lp2r_r = 0; lp6r_l = 0; lp6r_r = 0; u1r_l = 0; u1r_r = 0; u2r_l = 0; u2r_r = 0; u3r_l = 0; u3r_r = 0; uqr_l = 0; uqr_r = 0; wetr_l = 0; wetr_r = 0; yr_l = 0; yr_r = 0; z0r_l = 0; z0r_r = 0; z1r_l = 0; z1r_r = 0; z2r_l = 0; z2r_r = 0; z6r_l = 0; z6r_r = 0; zlr_l = 0; zlr_r = 0;\nif (rv_on > 0.5) {\n\n    u3r_l = accr_l - ib2r_l;                       // reconstruction LPF (2-pole Butterworth)\n    u1r_l = k_aa1 * ib1r_l + k_aa2 * u3r_l;\n    u2r_l = ib2r_l + k_aa2 * ib1r_l + k_aa3 * u3r_l;\n    ib1r_l = fixdenorm(2 * u1r_l - ib1r_l);\n    ib2r_l = fixdenorm(2 * u2r_l - ib2r_l);\n    eqyr_l = eq_b0 * u2r_l + eqz1r_l;                // droop compensation (TDF-II biquad)\n    eqz1r_l = fixdenorm(eq_b1 * u2r_l - eq_a1 * eqyr_l + eqz2r_l);\n    eqz2r_l = fixdenorm(eq_b2 * u2r_l - eq_a2 * eqyr_l);\n    uqr_l = u2r_l + (eqyr_l - u2r_l) * p_hf_comp;\n    v_tmp = (uqr_l - st_der_l) * g_de;             // de-emphasis\n    dlr_l = v_tmp + st_der_l;\n    st_der_l = fixdenorm(dlr_l + v_tmp);\n    yr_l = (dlr_l + 0.3 * (uqr_l - dlr_l)) * 0.199526231;   // back to analog nominal\n    v_tmp = (yr_l - lc0r_l) * g_lc0;               // LOW cut: half-order (-3 dB/oct)\n    lp0r_l = v_tmp + lc0r_l;\n    lc0r_l = fixdenorm(lp0r_l + v_tmp);\n    z0r_l = (yr_l - lp0r_l) + 0.5 * lp0r_l;\n    v_tmp = (z0r_l - lc1r_l) * g_lc1;\n    lp1r_l = v_tmp + lc1r_l;\n    lc1r_l = fixdenorm(lp1r_l + v_tmp);\n    z1r_l = (z0r_l - lp1r_l) + 0.5 * lp1r_l;\n    v_tmp = (z1r_l - lc2r_l) * g_lc2;\n    lp2r_l = v_tmp + lc2r_l;\n    lc2r_l = fixdenorm(lp2r_l + v_tmp);\n    z2r_l = (z1r_l - lp2r_l) + 0.5 * lp2r_l;\n    v_tmp = (yr_l - lc6r_l) * g_lc6;               // LOW cut: alternative first-order (-6 dB/oct)\n    lp6r_l = v_tmp + lc6r_l;\n    lc6r_l = fixdenorm(lp6r_l + v_tmp);\n    z6r_l = yr_l - lp6r_l;\n    zlr_l = z2r_l + (z6r_l - z2r_l) * s_lcs;\n    lor_l = yr_l + (zlr_l - yr_l) * s_lca;\n    v_tmp = (lor_l - hcsr_l) * g_hc;               // HIGH cut: first-order (-6 dB/oct)\n    hlr_l = v_tmp + hcsr_l;\n    hcsr_l = fixdenorm(hlr_l + v_tmp);\n    wetr_l = lor_l + (hlr_l - lor_l) * s_hca;\n\n\n    u3r_r = accr_r - ib2r_r;                       // reconstruction LPF (2-pole Butterworth)\n    u1r_r = k_aa1 * ib1r_r + k_aa2 * u3r_r;\n    u2r_r = ib2r_r + k_aa2 * ib1r_r + k_aa3 * u3r_r;\n    ib1r_r = fixdenorm(2 * u1r_r - ib1r_r);\n    ib2r_r = fixdenorm(2 * u2r_r - ib2r_r);\n    eqyr_r = eq_b0 * u2r_r + eqz1r_r;                // droop compensation (TDF-II biquad)\n    eqz1r_r = fixdenorm(eq_b1 * u2r_r - eq_a1 * eqyr_r + eqz2r_r);\n    eqz2r_r = fixdenorm(eq_b2 * u2r_r - eq_a2 * eqyr_r);\n    uqr_r = u2r_r + (eqyr_r - u2r_r) * p_hf_comp;\n    v_tmp = (uqr_r - st_der_r) * g_de;             // de-emphasis\n    dlr_r = v_tmp + st_der_r;\n    st_der_r = fixdenorm(dlr_r + v_tmp);\n    yr_r = (dlr_r + 0.3 * (uqr_r - dlr_r)) * 0.199526231;   // back to analog nominal\n    v_tmp = (yr_r - lc0r_r) * g_lc0;               // LOW cut: half-order (-3 dB/oct)\n    lp0r_r = v_tmp + lc0r_r;\n    lc0r_r = fixdenorm(lp0r_r + v_tmp);\n    z0r_r = (yr_r - lp0r_r) + 0.5 * lp0r_r;\n    v_tmp = (z0r_r - lc1r_r) * g_lc1;\n    lp1r_r = v_tmp + lc1r_r;\n    lc1r_r = fixdenorm(lp1r_r + v_tmp);\n    z1r_r = (z0r_r - lp1r_r) + 0.5 * lp1r_r;\n    v_tmp = (z1r_r - lc2r_r) * g_lc2;\n    lp2r_r = v_tmp + lc2r_r;\n    lc2r_r = fixdenorm(lp2r_r + v_tmp);\n    z2r_r = (z1r_r - lp2r_r) + 0.5 * lp2r_r;\n    v_tmp = (yr_r - lc6r_r) * g_lc6;               // LOW cut: alternative first-order (-6 dB/oct)\n    lp6r_r = v_tmp + lc6r_r;\n    lc6r_r = fixdenorm(lp6r_r + v_tmp);\n    z6r_r = yr_r - lp6r_r;\n    zlr_r = z2r_r + (z6r_r - z2r_r) * s_lcs;\n    lor_r = yr_r + (zlr_r - yr_r) * s_lca;\n    v_tmp = (lor_r - hcsr_r) * g_hc;               // HIGH cut: first-order (-6 dB/oct)\n    hlr_r = v_tmp + hcsr_r;\n    hcsr_r = fixdenorm(hlr_r + v_tmp);\n    wetr_r = lor_r + (hlr_r - lor_r) * s_hca;\n}\nelse {\n    ib1r_l = 0; ib2r_l = 0; st_der_l = 0; eqz1r_l = 0; eqz2r_l = 0; lc0r_l = 0; lc1r_l = 0; lc2r_l = 0; lc6r_l = 0; hcsr_l = 0;\n    ib1r_r = 0; ib2r_r = 0; st_der_r = 0; eqz1r_r = 0; eqz2r_r = 0; lc0r_r = 0; lc1r_r = 0; lc2r_r = 0; lc6r_r = 0; hcsr_r = 0;\n}\nwo_l = wet_l; wo_r = wet_r;     // output path\nwf_l = wet_l; wf_r = wet_r;     // regeneration path (and the EXT send)\nif (rv_on > 0.5) {\n    wo_l = wet_l + (wetr_l - wet_l) * g_rvo;\n    wo_r = wet_r + (wetr_r - wet_r) * g_rvo;\n    wf_l = wet_l + (wetr_l - wet_l) * g_rvf;\n    wf_r = wet_r + (wetr_r - wet_r) * g_rvf;\n}\nfbn_l = wf_l * s_fb * s_fbs * s_fbi + ret_l * s_ret * cal_live;   // regeneration: internal + EXT return\nfbn_r = wf_r * s_fb * s_fbs * s_fbi + ret_r * s_ret * cal_live;   // regeneration: internal + EXT return\n\n// ============================================================ OUTPUT\nmx_l = a_l * s_bal_d + s_so * wo_l * s_bal_w;     // VARIABLE / +MIX\nmn_l = a_l * s_bal_d - wo_l * s_bal_w;            // -MIX (always difference)\nmx_r = a_r * s_bal_d + s_so * wo_r * s_bal_w;\ndr_l = a_l * s_dir;                               // DIRECT\no_l = mx_l * s_m0 + dr_l * s_m1 + mx_l * s_m2 + mx_l * s_m3;\no_r = mx_l * s_m0 + mx_l * s_m1 + mn_l * s_m2 + mx_r * s_m3;\no_m = (o_l + o_r) * 0.5;\no_s = (o_l - o_r) * 0.5 * s_width;\no_l = o_m + o_s;\no_r = o_m - o_s;\nog = s_oatt * s_ogain;\noc_l = ((o_l) / pow(1 + pow(abs(o_l), 5), 0.2));          // output amp rail (part of the character stage)\noc_r = ((o_r) / pow(1 + pow(abs(o_r), 5), 0.2));\nsf_l = (o_l + (oc_l - o_l) * s_pre) * og;\nsf_r = (o_r + (oc_r - o_r) * s_pre) * og;\n// safety ceiling (modern): transparent below +6 dBFS, never above +12 dBFS\nout1 = fixnan(sf_l / pow(1 + pow(abs(sf_l) * 0.25, 8), 0.125));\nout2 = fixnan(sf_r / pow(1 + pow(abs(sf_r) * 0.25, 8), 0.125));\nout3 = fixnan(20 * log10(max(mtr, 0.00001)) + 3);   // HEADROOM meter, dB\nout4 = fixnan(m_s);                                  // LFO / ENV LED\nout5 = fixnan(ms_disp);                              // delay time for the display (TIME, before LOOP COMP)\n// v1.0.2-rc4: EXT loop send (device outputs 3/4): the regeneration tap after LOW/HIGH, unity gain\nout6 = fixnan(wf_l / pow(1 + pow(abs(wf_l) * 0.25, 8), 0.125) * cal_live + cal_click);\nout7 = fixnan(wf_r / pow(1 + pow(abs(wf_r) * 0.25, 8), 0.125) * cal_live + cal_click);\nout8 = cal_out;                                      // rc5: CAL result for the patcher\n\n// ============================================================= STORE\nh_sr = fixnan(sr);\nh_g_pre = fixnan(g_pre);\nh_g_de = fixnan(g_de);\nh_g_aa = fixnan(g_aa);\nh_k_aa1 = fixnan(k_aa1);\nh_k_aa2 = fixnan(k_aa2);\nh_k_aa3 = fixnan(k_aa3);\nh_g_dc = fixnan(g_dc);\nh_g_tone = fixnan(g_tone);\nh_k_pk = fixnan(k_pk);\nh_g_lc0 = fixnan(g_lc0);\nh_g_lc1 = fixnan(g_lc1);\nh_g_lc2 = fixnan(g_lc2);\nh_g_lc6 = fixnan(g_lc6);\nh_g_hc = fixnan(g_hc);\nh_s_rg = fixnan(s_rg);\nh_s_w1 = fixnan(s_w1);\nh_s_lvl = fixnan(s_lvl);\nh_s_pre = fixnan(s_pre);\nh_s_drv = fixnan(s_drv);\nh_s_tone = fixnan(s_tone);\nh_s_trim = fixnan(s_trim);\nh_s_fb = fixnan(s_fb);\nh_s_fbs = fixnan(s_fbs);\nh_s_int = fixnan(s_int);\nh_s_bal_d = fixnan(s_bal_d);\nh_s_bal_w = fixnan(s_bal_w);\nh_s_so = fixnan(s_so);\nh_s_byp = fixnan(s_byp);\nh_s_sat = fixnan(s_sat);\nh_s_conv = fixnan(s_conv);\nh_s_lcs = fixnan(s_lcs);\nh_s_lca = fixnan(s_lca);\nh_s_hca = fixnan(s_hca);\nh_s_lclg = fixnan(s_lclg);\nh_s_hclg = fixnan(s_hclg);\nh_s_oatt = fixnan(s_oatt);\nh_s_ogain = fixnan(s_ogain);\nh_s_width = fixnan(s_width);\nh_s_dir = fixnan(s_dir);\nh_s_m0 = fixnan(s_m0);\nh_s_m1 = fixnan(s_m1);\nh_s_m2 = fixnan(s_m2);\nh_s_m3 = fixnan(s_m3);\nh_s_hm = fixnan(s_hm);\nh_st_tone_l = fixnan(st_tone_l);\nh_st_tone_r = fixnan(st_tone_r);\nh_