\nh_st_der_l = fixnan(st_der_l);\nh_st_der_r = fixnan(st_der_r);\nh_eqz1r_l = fixnan(eqz1r_l);\nh_eqz1r_r = fixnan(eqz1r_r);\nh_eqz2r_l = fixnan(eqz2r_l);\nh_eqz2r_r = fixnan(eqz2r_r);\nh_lc0r_l = fixnan(lc0r_l);\nh_lc0r_r = fixnan(lc0r_r);\nh_lc1r_l = fixnan(lc1r_l);\nh_lc1r_r = fixnan(lc1r_r);\nh_lc2r_l = fixnan(lc2r_l);\nh_lc2r_r = fixnan(lc2r_r);\nh_lc6r_l = fixnan(lc6r_l);\nh_lc6r_r = fixnan(lc6r_r);\nh_hcsr_l = fixnan(hcsr_l);\nh_hcsr_r = fixnan(hcsr_r);\nh_lc_done = s_lclg;\nh_init = 1;\nh_hc_done = s_hclg;\nh_xp_l = fixnan(xc_l);\nh_xp_r = fixnan(xc_r);\nh_fb_l = fixnan(fbn_l);\nh_fb_r = fixnan(fbn_r);\n",
