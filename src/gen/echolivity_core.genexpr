History h_xp_r(0);

// ---------------------------------------------------- frame setup
sr = samplerate;
inv_sr = 1 / sr;
v_tmp = 0;
k15 = 1 - exp(-1 / (0.015 * sr));   // 15 ms parameter smoothing
k5 = 1 - exp(-1 / (0.005 * sr));
k30 = 1 - exp(-1 / (0.03 * sr));

// cached coefficients (recomputed only when the host rate changes)
g_pre = h_g_pre; g_de = h_g_de; g_aa = h_g_aa; k_aa1 = h_k_aa1; k_aa2 = h_k_aa2; k_aa3 = h_k_aa3;
g_dc = h_g_dc; g_tone = h_g_tone; k_pk = h_k_pk;
eq_b0 = h_eq_b0; eq_b1 = h_eq_b1; eq_b2 = h_eq_b2; eq_a1 = h_eq_a1; eq_a2 = h_eq_a2;
v_g = 0; hf_fa = 0; hf_f0 = 0; hf_gdb = 0; hf_q = 0; eq_a = 0; eq_w = 0; eq_al = 0; eq_n = 0;
if (sr != h_sr) {
    v_g = tan(pi * 10610 / sr);  g_pre = v_g / (1 + v_g);     // pre-emph pole 15 us
    v_g = tan(pi * 3183 / sr);   g_de = v_g / (1 + v_g);      // de-emph pole 50 us
    hf_fa = 22000; hf_f0 = 15000; hf_gdb = 0; hf_q = 0.7;
    if (sr < 46050.0) {
        hf_fa = 23941.000; hf_f0 = 17986.118; hf_gdb = 4.1149; hf_q = 0.2000;
    }
    else if (sr < 68100.0) {
        hf_fa = 23941.000; hf_f0 = 16877.142; hf_gdb = 2.1741; hf_q = 0.2875;
    }
    else if (sr < 92100.0) {
        hf_fa = 23941.000; hf_f0 = 30822.785; hf_gdb = 0.8670; hf_q = 0.2000;
    }
    else if (sr < 136200.0) {
        hf_fa = 23941.000; hf_f0 = 10095.546; hf_gdb = 0.1992; hf_q = 0.5165;
    }
    else if (sr < 184200.0) {
        hf_fa = 23941.000; hf_f0 = 64365.835; hf_gdb = 0.4918; hf_q = 0.2000;
    }
    else {
        hf_fa = 23941.000; hf_f0 = 45098.954; hf_gdb = -0.6105; hf_q = 0.2000;
    }
    // RBJ peaking EQ: compensates the host-rate interpolation/averaging droop
    eq_a = pow(10, hf_gdb * 0.025);
    eq_w = 2 * pi * min(hf_f0, 0.49 * sr) / sr;
    eq_al = sin(eq_w) / (2 * hf_q);
    eq_n = 1 / (1 + eq_al / eq_a);
    eq_b0 = (1 + eq_al * eq_a) * eq_n;
    eq_b1 = -2 * cos(eq_w) * eq_n;
    eq_b2 = (1 - eq_al * eq_a) * eq_n;
    eq_a1 = eq_b1;
    eq_a2 = (1 - eq_al / eq_a) * eq_n;
    v_g = tan(pi * min(hf_fa, 0.45 * sr) / sr);  g_aa = v_g;   // AA / reconstruction 2-pole
    k_aa1 = 1 / (1 + v_g * (v_g + 1.41421356));
    k_aa2 = v_g * k_aa1;
    k_aa3 = v_g * k_aa2;
    v_g = tan(pi * 5 / sr);      g_dc = v_g / (1 + v_g);      // 5 Hz DC block in loop
    v_g = tan(pi * 800 / sr);    g_tone = v_g / (1 + v_g);
    k_pk = exp(-1 / (0.3 * sr));                              // meter release
}
v_g = 0;

s_rg = h_s_rg;
s_w1 = h_s_w1;
s_lvl = h_s_lvl;
s_pre = h_s_pre;
s_drv = h_s_drv;
s_tone = h_s_tone;
s_trim = h_s_trim;
s_fb = h_s_fb;
s_fbs = h_s_fbs;
s_int = h_s_int;
s_bal_d = h_s_bal_d;
s_bal_w = h_s_bal_w;
s_so = h_s_so;
s_byp = h_s_byp;
s_sat = h_s_sat;
s_conv = h_s_conv;
s_lcs = h_s_lcs;
s_lca = h_s_lca;
s_hca = h_s_hca;
s_lclg = h_s_lclg;
s_hclg = h_s_hclg;
s_oatt = h_s_oatt;
s_ogain = h_s_ogain;
s_width = h_s_width;
s_dir = h_s_dir;
s_m0 = h_s_m0;
s_m1 = h_s_m1;
s_m2 = h_s_m2;
s_m3 = h_s_m3;
s_hm = h_s_hm;
s_fbi = h_s_fbi;
s_ret = h_s_ret;

// ----------------------------------------------- parameter targets
t_rg = 1;
t_w1 = 0;
if (p_in_range < 0.5) {
    t_rg = 5.011872;   // -30 range: x10 Hi-Z amp, then same pad as -10
    t_w1 = 1;
}
else if (p_in_range < 1.5) {
    t_rg = 5.011872;   // -10 range: +14 dB
}
t_lvl = (p_in_level * 0.2) * (p_in_level * 0.2);   // LEVEL: 5 -> 0 dB, 10 -> +12 dB (approx. taper)
t_drv = pow(10, p_drive * 0.05);
t_trim = pow(10, p_pre_trim * 0.05);
if (p_pre_comp > 0.5) {
    t_trim = t_trim / t_drv;
}
t_fbs = 1;
if (p_fb_inv > 0.5) {
    t_fbs = -1;
}
// v1.0.2-rc4: regeneration route. INT: internal loop only (identical to rc3).
// EXT: the loop leaves on outs 6/7 (device outputs 3/4) and only the return (device inputs 3/4)
// is regenerated. BOTH: internal loop plus the return.
t_fbi = 1;
t_ret = 0;
if (p_fb_route > 0.5) {
    t_ret = p_return * 0.142857143;
}
if (p_fb_route > 0.5 && p_fb_route < 1.5) {
    t_fbi = 0;
}
t_so = 1;
if (p_out_inv > 0.5) {
    t_so = -1;
}
t_bd = min(1, (10 - p_balance) * 0.2);
t_bw = min(1, p_balance * 0.2);
t_dir = 1;
if (p_wet_only > 0.5) {
    t_bd = 0;
    t_dir = 0;
}
t_byp = 0;
if (p_bypass > 0.5) {
    t_byp = 1;
    t_bd = 1;
    t_bw = 0;
    t_dir = 1;
}
t_oatt = 1;
if (p_out_range < 0.5) {
    t_oatt = 0.063096;   // -20 dBm: -24 dB re +4
}
else if (p_out_range < 1.5) {
    t_oatt = 0.199526;   // -10 dBm: -14 dB re +4
}
t_lca = 0;
t_lclg = s_lclg;
if (t_lclg < 1) {
    t_lclg = 6.965784;
}
if (p_lowcut > 2.5) {
    t_lca = 1;
    t_lclg = 8.965784;   // log2(500)
}
else if (p_lowcut > 1.5) {
    t_lca = 1;
    t_lclg = 7.965784;   // log2(250)
}
else if (p_lowcut > 0.5) {
    t_lca = 1;
    t_lclg = 6.965784;   // log2(125)
}
t_hca = 0;
t_hclg = s_hclg;
if (t_hclg < 1) {
    t_hclg = 12.965784;
}
if (p_highcut > 2.5) {
    t_hca = 1;
    t_hclg = 10.965784;  // log2(2000)
}
else if (p_highcut > 1.5) {
    t_hca = 1;
    t_hclg = 11.965784;  // log2(4000)
}
else if (p_highcut > 0.5) {
    t_hca = 1;
    t_hclg = 12.965784;  // log2(8000)
}
if (s_lclg < 1) {
    s_lclg = t_lclg;      // first frame: jump to the selected position
    s_hclg = t_hclg;
}
t_m0 = 0; t_m1 = 0; t_m2 = 0; t_m3 = 0;
if (p_out_mode > 2.5) {
    t_m3 = 1;
}
else if (p_out_mode > 1.5) {
    t_m2 = 1;
}
else if (p_out_mode > 0.5) {
    t_m1 = 1;
}
else {
    t_m0 = 1;
}

// first frame after load: start at the targets (no ramps on load)
if (h_init < 0.5) {
    s_rg = t_rg;
    s_w1 = t_w1;
    s_lvl = t_lvl;
    s_pre = p_pre_on;
    s_drv = t_drv;
    s_tone = p_tone;
    s_trim = t_trim;
    s_fb = p_feedback * 0.142857143;
    s_int = p_intensity * 0.1;
    s_bal_d = t_bd;
    s_bal_w = t_bw;
    s_sat = p_loop_sat;
    s_conv = p_converter;
    s_lcs = p_lc_slope;
    s_oatt = t_oatt;
    s_ogain = pow(10, p_out_gain * 0.05);
    s_width = p_width;
    s_dir = t_dir;
    s_m0 = t_m0;
    s_m1 = t_m1;
    s_m2 = t_m2;
    s_m3 = t_m3;
    s_fbs = t_fbs;
    s_so = t_so;
    s_byp = t_byp;
    s_lca = t_lca;
    s_hca = t_hca;
    s_fbi = t_fbi;
    s_ret = t_ret;
}
// ------------------------------------------------------- smoothing
s_rg = s_rg + (t_rg - s_rg) * k15;
s_w1 = s_w1 + (t_w1 - s_w1) * k15;
s_lvl = s_lvl + (t_lvl - s_lvl) * k15;
s_pre = s_pre + (p_pre_on - s_pre) * k15;
s_drv = s_drv + (t_drv - s_drv) * k15;
s_tone = s_tone + (p_tone - s_tone) * k15;
s_trim = s_trim + (t_trim - s_trim) * k15;
s_fb = s_fb + (p_feedback * 0.142857143 - s_fb) * k15;
s_int = s_int + (p_intensity * 0.1 - s_int) * k15;
s_bal_d = s_bal_d + (t_bd - s_bal_d) * k15;
s_bal_w = s_bal_w + (t_bw - s_bal_w) * k15;
s_sat = s_sat + (p_loop_sat - s_sat) * k15;
s_conv = s_conv + (p_converter - s_conv) * k15;
s_lcs = s_lcs + (p_lc_slope - s_lcs) * k15;
s_oatt = s_oatt + (t_oatt - s_oatt) * k15;
s_ogain = s_ogain + (pow(10, p_out_gain * 0.05) - s_ogain) * k15;
s_width = s_width + (p_width - s_width) * k15;
s_dir = s_dir + (t_dir - s_dir) * k15;
s_m0 = s_m0 + (t_m0 - s_m0) * k15;
s_m1 = s_m1 + (t_m1 - s_m1) * k15;
s_m2 = s_m2 + (t_m2 - s_m2) * k15;
s_m3 = s_m3 + (t_m3 - s_m3) * k15;
s_fbi = s_fbi + (t_fbi - s_fbi) * k15;
s_ret = s_ret + (t_ret - s_ret) * k15;
s_fbs = s_fbs + (t_fbs - s_fbs) * k5;
s_so = s_so + (t_so - s_so) * k5;
s_byp = s_byp + (t_byp - s_byp) * k5;
s_lca = s_lca + (t_lca - s_lca) * k5;
s_hca = s_hca + (t_hca - s_hca) * k5;
s_lclg = s_lclg + (t_lclg - s_lclg) * k30;
s_hclg = s_hclg + (t_hclg - s_hclg) * k30;

// switched-filter coefficients: recomputed only while a switch is moving
g_lc0 = h_g_lc0; g_lc1 = h_g_lc1; g_lc2 = h_g_lc2; g_lc6 = h_g_lc6; g_hc = h_g_hc;
if (abs(s_lclg - h_lc_done) > 0.00001 || sr != h_sr) {
    v_g = pow(2, s_lclg);
    g_lc6 = tan(pi * min(v_g, 0.45 * sr) * inv_sr);  g_lc6 = g_lc6 / (1 + g_lc6);
    v_g = v_g * 1.25;   // half-order (-3 dB/oct) approximation: 3 pole/zero pairs, 2 oct apart
    g_lc0 = tan(pi * min(v_g, 0.45 * sr) * inv_sr);  g_lc0 = g_lc0 / (1 + g_lc0);
    g_lc1 = tan(pi * v_g * 0.25 * inv_sr);  g_lc1 = g_lc1 / (1 + g_lc1);
    g_lc2 = tan(pi * v_g * 0.0625 * inv_sr);  g_lc2 = g_lc2 / (1 + g_lc2);
}
if (abs(s_hclg - h_hc_done) > 0.00001 || sr != h_sr) {
    v_g = pow(2, s_hclg);
    g_hc = tan(pi * min(v_g, 0.45 * sr) * inv_sr);  g_hc = g_hc / (1 + g_hc);
}
v_g = 0;

// ============================================================ INPUT
in_l = clamp(fixnan(in1), -1000, 1000);   // v1.0.2: NaN -> 0, +-inf -> +-1000 (+60 dBFS); valid audio unchanged
in_r = clamp(fixnan(in2), -1000, 1000);
ret_l = clamp(fixnan(in3), -1000, 1000);   // v1.0.2-rc4: EXT loop return (device inputs 3/4)
ret_r = clamp(fixnan(in4), -1000, 1000);
// rc5: CAL. Fade the external loop out (20 ms), wait (30 ms), send one click on outputs 3/4, time its
// arrival on inputs 3/4 (max 500 ms), fade back in. Result (ms, or -1 = not found) on out8 for 100 ms.
cal_st = h_cal_st; cal_n = h_cal_n; cal_m = h_cal_m; cal_env = h_cal_env; cal_res = h_cal_res; cal_hold = h_cal_hold;
cal_prev = p_cal;
if (p_cal > 0.5 && h_cal_prev < 0.5 && cal_st < 0.5 && p_fb_route > 0.5) {
    cal_st = 1;
    cal_n = 0;
}
cal_click = 0;
cal_a = abs(ret_l) + abs(ret_r);
if (cal_st > 0.5) {
    cal_n = cal_n + 1;
}
if (cal_st > 0.5 && cal_st < 1.5) {
    cal_m = min(cal_m + 50 / sr, 1);
    if (cal_n > 0.05 * sr) {
        cal_st = 2;
        cal_n = 0;
        cal_env = 0;
    }
}
else if (cal_st > 1.5 && cal_st < 2.5) {
    if (cal_n < 1.5) {
        cal_click = 0.9;
    }
    if (cal_n > 1.5 && cal_a > 0.25 && cal_a > 4 * cal_env) {
        cal_res = (cal_n - 1) * 1000 / sr;
        cal_hold = 0.1 * sr;
        cal_st = 3;
        cal_n = 0;
    }
    else if (cal_n > 0.5 * sr) {
        cal_res = -1;
        cal_hold = 0.1 * sr;
        cal_st = 3;
        cal_n = 0;
    }
    cal_env = cal_env + (cal_a - cal_env) * 0.002;
}
else if (cal_st > 2.5) {
    cal_m = max(cal_m - 50 / sr, 0);
    if (cal_m < 0.0000001) {
        cal_m = 0;
        cal_st = 0;
    }
}
cal_out = -2;
if (cal_hold > 0.5) {
    cal_out = cal_res;
    cal_hold = cal_hold - 1;
}
cal_live = 1 - cal_m;
x_m = (in_l + in_r) * 0.5;
x_l = x_m;
x_r = x_m;
if (s_m3 > 0.000001) {
    x_l = x_m + (in_l - x_m) * s_m3;     // TRUE STEREO (modern) keeps L/R separate
    x_r = x_m + (in_r - x_m) * s_m3;
}
st_tone_l = h_st_tone_l; st_tone_r = h_st_tone_r;

// -- channel l : attenuator / Hi-Z amp / LEVEL / op-amp stage (approximation)
s1c_l = x_l + (((x_l * 10) / pow(1 + pow(abs(x_l * 10), 5), 0.2)) - x_l) * s_w1;          // -30 range: x10 Hi-Z amp with rail clip
s1l_l = x_l * (1 + 9 * s_w1);                // same, linear (character off)
v_tmp = (s1c_l * s_rg * s_lvl - st_tone_l) * g_tone;
tl_l = v_tmp + st_tone_l;
st_tone_l = fixdenorm(tl_l + v_tmp);
th_l = s1c_l * s_rg * s_lvl - tl_l;
tt_l = tl_l * pow(2, -s_tone) + th_l * pow(2, s_tone);     // +-6 dB tilt
dv_l = tt_l * s_drv;
ac_l = ((dv_l) / pow(1 + pow(abs(dv_l), 5), 0.2)) * s_trim;                          // amp B rail clip (+17 dB over nominal at LEVEL 5)
al_l = s1l_l * s_rg * s_lvl;
a_l = al_l + (ac_l - al_l) * s_pre;       // preamp output = DIRECT signal


// -- channel r : attenuator / Hi-Z amp / LEVEL / op-amp stage (approximation)
s1c_r = x_r + (((x_r * 10) / pow(1 + pow(abs(x_r * 10), 5), 0.2)) - x_r) * s_w1;          // -30 range: x10 Hi-Z amp with rail clip
s1l_r = x_r * (1 + 9 * s_w1);                // same, linear (character off)
v_tmp = (s1c_r * s_rg * s_lvl - st_tone_r) * g_tone;
tl_r = v_tmp + st_tone_r;
st_tone_r = fixdenorm(tl_r + v_tmp);
th_r = s1c_r * s_rg * s_lvl - tl_r;
tt_r = tl_r * pow(2, -s_tone) + th_r * pow(2, s_tone);     // +-6 dB tilt
dv_r = tt_r * s_drv;
ac_r = ((dv_r) / pow(1 + pow(abs(dv_r), 5), 0.2)) * s_trim;                          // amp B rail clip (+17 dB over nominal at LEVEL 5)
al_r = s1l_r * s_rg * s_lvl;
a_r = al_r + (ac_r - al_r) * s_pre;       // preamp output = DIRECT signal


// ======================================================= MODULATION
lph = h_lph; rnd_t = h_rnd_t; rnd1 = h_rnd1; rnd2 = h_rnd2; envf = h_envf; m_s = h_m_s;
f_hz = 0.1 * pow(150, p_frequency * 0.1);   // 0 -> 0.1 Hz (10 s), 10 -> 15 Hz
lph = lph + f_hz * inv_sr;
lwrap = 0;
if (lph >= 1) {
    lph = lph - 1;
    lwrap = 1;
}
tri = 1 - abs(2 * lph - 1);
m_tri = (sqrt(tri * tri + 0.0144) - 0.12) * 1.127172;   // sharp peak, rounded trough (SM Fig.3)
m_sq = 0;
if (lph >= 0.5) {
    m_sq = 1;
}
if (lwrap > 0.5) {
    rnd_t = noise() * 0.5 + 0.5;    // new random level once per LFO cycle
}
k_rnd = 1 - exp(-4 * f_hz * inv_sr);   // 'integrated' (smoothed) S&H
rnd1 = rnd1 + (rnd_t - rnd1) * k_rnd;
rnd2 = fixdenorm(rnd2 + (rnd1 - rnd2) * k_rnd);
e_in = max(abs(a_l), abs(a_r)) * 5.011872 * pow(10, p_env_sens * 0.05);
if (e_in > envf) {
    envf = envf + (e_in - envf) * (1 - exp(-1 / (0.002 * sr)));
}
else {
    envf = fixdenorm(envf + (e_in - envf) * (1 - exp(-1 / (p_env_rel * 0.001 * sr))));
}
m_env = clamp(envf * 1.412538, 0, 1);    // nominal level (meter 0 dB) = full swing
m_raw = m_tri;
if (p_waveform > 2.5) {
    m_raw = m_env;
}
else if (p_waveform > 1.5) {
    m_raw = rnd2;
}
else if (p_waveform > 0.5) {
    m_raw = m_sq;
}
m_s = m_s + (m_raw - m_s) * (1 - exp(-1 / (0.0007 * sr)));   // VCO control lag
fv = 64000 * (1 + s_int * m_s);    // memory clock: 64 kHz nominal, up to 2:1 (delay -> 50%)

// ======================================================= DELAY TIME
ms = p_time_ms;
if (p_time_mode < 0.5) {
    ms = floor(p_time_ms + 0.5);     // authentic 1 ms steps
}
beats = 4;
if (p_sync > 0.5) {
    if (p_division < 0.5) {
        beats = 0.125000000;
    }
    else if (p_division < 1.5) {
        beats = 0.250000000;
    }
    else if (p_division < 2.5) {
        beats = 0.333333333;
    }
    else if (p_division < 3.5) {
        beats = 0.500000000;
    }
    else if (p_division < 4.5) {
        beats = 0.666666667;
    }
    else if (p_division < 5.5) {
        beats = 0.750000000;
    }
    else if (p_division < 6.5) {
        beats = 1.000000000;
    }
    else if (p_division < 7.5) {
        beats = 1.333333333;
    }
    else if (p_division < 8.5) {
        beats = 1.500000000;
    }
    else if (p_division < 9.5) {
        beats = 2.000000000;
    }
    if (p_division > 10.5 && p_division < 11.5) {
        beats = 0.166666667;     // rc5: 1/16T
    }
    if (p_division > 11.5) {
        beats = 0.083333333;     // rc5: 1/32T
    }
    ms = clamp(60000 / max(p_tempo, 20) * beats, 0, 1023);
}
ms_disp = ms;
// rc5: LOOP COMP. In EXT the external pass adds Live's routing latency; shorten the internal delay
// by the same amount so the repeat period equals TIME. Not applied in INT or BOTH.
if (p_loop_comp > 0 && p_fb_route > 0.5 && p_fb_route < 1.5) {
    ms = max(ms - p_loop_comp, 1);
}
n_tgt = fixnan(clamp(ms * 64, 0, 65472));
na = h_na; nb = h_nb; xf = h_xf; xdir = h_xdir; ns = h_ns;
act = 0;
xstep = 0;
if (p_time_glide > 0.5) {
    ns = ns + (n_tgt - ns) * (1 - exp(-1 / (0.12 * sr)));
    na = ns;
    nb = ns;
    xf = 0;
    xdir = 0;
}
else {
    if (abs(xf - xdir) < 0.0000001) {
        act = na;
        if (xdir > 0.5) {
            act = nb;
        }
        if (abs(n_tgt - act) > 0.001) {
            if (xdir > 0.5) {
                na = n_tgt;
                xdir = 0;
            }
            else {
                nb = n_tgt;
                xdir = 1;
            }
        }
    }
    xstep = inv_sr / 0.025;     // 25 ms equal-power crossfade between taps
    xf = xf + clamp(xdir - xf, -xstep, xstep);
    ns = na + (nb - na) * xf;
}
g_a = cos(xf * 1.570796327);
g_b = sin(xf * 1.570796327);

// ============================================================= HOLD
// v1.0.2: state machine  hst 0 = normal, 1 = held, 2 = releasing (loop audible),
// 3 = releasing, loop faded early because the HOLD reader would reach new audio (delays > ~944 ms).
// Engage is unchanged from v1.0.1. On release the HOLD loop keeps playing while the
// writer restarts just behind the HOLD reader; once the normal tap reads only newly
// written memory (one delay time later) the loop crossfades out over 10 ms.
w = h_w; hpos = h_hpos; hbase = h_hbase; hst = h_hst; relk = h_relk; g_w = h_g_w; gnt = h_gnt;
hshape = h_hshape;   // 1 while a release fade (or its reversal) is in progress: smoothstep weighting
if (h_init < 0.5) {
    g_w = 1;
    gnt = 1;
}
hold_on = 0;
n_dom = 0;
hr0 = 0;
if (p_hold > 0.5) {
    hold_on = 1;
}
if (hold_on > 0.5 && hst < 0.5) {
    if (s_hm > 0.000001) {
        hst = 1;     // re-engaged while the previous loop is still audible: keep it, no jump
    }
    else {
        hbase = w;   // loop = the last 1008 ms written; playback continues from the current tap
        n_dom = na;
        if (g_b > g_a) {
            n_dom = nb;
        }
        hpos = clamp(floor(64512 - n_dom + 0.5), 0, 64511);
        g_w = 0;     // memory writes stop immediately (as v1.0.1)
        hst = 1;
    }
}
else if (hold_on > 0.5 && hst > 1.5) {
    hst = 1;         // re-engaged during the release window: keep the loop, fade the writes out
}
else if (hold_on < 0.5 && hst > 0.5 && hst < 1.5 && s_hm >= 1) {
    hr0 = hbase - 64512 + hpos - 1;   // writer restarts one word behind the HOLD reader
    if (hr0 < 0) {
        hr0 = hr0 + 65536;
    }
    w = hr0;
    relk = 0;
    hst = 2;
}
hm_t = 0;
hm_step = inv_sr / 0.010;      // release: 10 ms crossfade back to the normal tap
if (hst > 0.5 && hst < 2.5) {
    hm_t = 1;
    hm_step = inv_sr / 0.005;  // engage: 5 ms (as v1.0.1)
}
s_hm = s_hm + clamp(hm_t - s_hm, -hm_step, hm_step);
if (s_hm >= 1 || s_hm <= 0) {
    hshape = 0;
}
hm_w = s_hm;                   // engage / held: linear (as v1.0.1)
if (hshape > 0.5) {
    hm_w = s_hm * s_hm * (3 - 2 * s_hm);   // release fade: smoothstep, no slope corners; stays
}                                          // smoothstep if HOLD is pressed again mid-fade (continuous)
// normal-tap gain: muted while releasing until the tap reads only new audio
gnt_t = 1;
if (hst > 1.5) {
    gnt_t = 0;
}
if (gnt_t > 0.5 && s_hm >= 1) {
    gnt = 1;                   // loop still fully audible: switch silently
}
gnt = gnt + clamp(gnt_t - gnt, -inv_sr / 0.010, inv_sr / 0.010);
gnt_w = gnt * gnt * (3 - 2 * gnt);
w_tgt = 1;
if (hst > 0.5 && hst < 1.5) {
    w_tgt = 0;
}

// ======================================== FEEDBACK SUM -> A/D chain
fb_l = h_fb_l; fb_r = h_fb_r;
st_pre_l = h_st_pre_l; st_pre_r = h_st_pre_r; st_dc_l = h_st_dc_l; st_dc_r = h_st_dc_r;
ia1_l = h_ia1_l; ia2_l = h_ia2_l; ia1_r = h_ia1_r; ia2_r = h_ia2_r;

d_l = (a_l + fb_l) * 5.011872;              // summing amp -> converter scale (meter tap)
dg_l = d_l * (1 - s_byp);                    // BYPASS grounds the converter input
v_tmp = (dg_l - st_pre_l) * g_pre;           // pre-emphasis (50/15 us shelf, +10.5 dB HF)
pl_l = v_tmp + st_pre_l;
st_pre_l = fixdenorm(pl_l + v_tmp);
pe_l = pl_l + 3.333333 * (dg_l - pl_l);
v3_l = pe_l - ia2_l;                        // anti-alias LPF (2-pole Butterworth)
v1_l = k_aa1 * ia1_l + k_aa2 * v3_l;
v2_l = ia2_l + k_aa2 * ia1_l + k_aa3 * v3_l;
ia1_l = fixdenorm(2 * v1_l - ia1_l);
ia2_l = fixdenorm(2 * v2_l - ia2_l);
v_tmp = (v2_l - st_dc_l) * g_dc;             // 5 Hz DC block (no DC accumulation)
dcl_l = v_tmp + st_dc_l;
st_dc_l = fixdenorm(dcl_l + v_tmp);
xs_l = v2_l - dcl_l;
xsat_l = 0.98 * ((xs_l * 1.0204) / pow(1 + pow(abs(xs_l * 1.0204), 5), 0.2));
xc_l = xs_l + (xsat_l - xs_l) * s_sat;    // optional soft loop saturation


d_r = (a_r + fb_r) * 5.011872;              // summing amp -> converter scale (meter tap)
dg_r = d_r * (1 - s_byp);                    // BYPASS grounds the converter input
v_tmp = (dg_r - st_pre_r) * g_pre;           // pre-emphasis (50/15 us shelf, +10.5 dB HF)
pl_r = v_tmp + st_pre_r;
st_pre_r = fixdenorm(pl_r + v_tmp);
pe_r = pl_r + 3.333333 * (dg_r - pl_r);
v3_r = pe_r - ia2_r;                        // anti-alias LPF (2-pole Butterworth)
v1_r = k_aa1 * ia1_r + k_aa2 * v3_r;
v2_r = ia2_r + k_aa2 * ia1_r + k_aa3 * v3_r;
ia1_r = fixdenorm(2 * v1_r - ia1_r);
ia2_r = fixdenorm(2 * v2_r - ia2_r);
v_tmp = (v2_r - st_dc_r) * g_dc;             // 5 Hz DC block (no DC accumulation)
dcl_r = v_tmp + st_dc_r;
st_dc_r = fixdenorm(dcl_r + v_tmp);
xs_r = v2_r - dcl_r;
xsat_r = 0.98 * ((xs_r * 1.0204) / pow(1 + pow(abs(xs_r * 1.0204), 5), 0.2));
xc_r = xs_r + (xsat_r - xs_r) * s_sat;    // optional soft loop saturation

pk = max(abs(d_l), abs(d_r));
mtr = h_mtr * k_pk;
if (pk > mtr) {
    mtr = pk;
}

// ================================== MEMORY CLOCK EMULATION (ticks)
// The 64K-word memory runs on its own (modulated) clock. Every tick
// converts the interpolated input, writes one word and reads the taps;
// the DAC output is a zero-order hold, integrated over the host sample.
ph = h_ph;
xp_l = h_xp_l; xp_r = h_xp_r;
dac_l = h_dac_l; dac_r = h_dac_r;
inc = fv * inv_sr;
tdt = 1 / inc;
tt = (1 - ph) * tdt;
tl = 0;
nt = 0;
acc_l = 0; acc_r = 0;
lsb_q = 1 - s_conv;
xi_l = 0;
xi_r = 0;
q_l = 0;
q_r = 0;
ra = 0;
ia = 0;
fa = 0;
ib = 0;
rb = 0;
jb = 0;
fb2 = 0;
jb2 = 0;
ta_l = 0;
ta_r = 0;
tb_l = 0;
tb_r = 0;
hr = 0;
hr2 = 0;
hg = 0;
hv_l = 0;
hv_r = 0;
wl = 0;
wr = 0;
ia2 = 0;
q13_l = 0;
q13_r = 0;
g_ws = 0;
while (tt < 1 && nt < 8) {
    acc_l = acc_l + dac_l * (tt - tl);
    acc_r = acc_r + dac_r * (tt - tl);
    xi_l = clamp(xp_l + (xc_l - xp_l) * tt, -1, 0.999755859);   // converter full scale
    if (abs(xi_l) < 0.5) {
        q13_l = floor(xi_l * 4096 + 0.5) * 0.000244140625;   // gain-ranged: +6 dB before the 12-bit converter
    }
    else {
        q13_l = floor(xi_l * 2048 + 0.5) * 0.00048828125;    // 12-bit
    }
    q_l = xi_l + (q13_l - xi_l) * lsb_q;
    xi_r = clamp(xp_r + (xc_r - xp_r) * tt, -1, 0.999755859);   // converter full scale
    if (abs(xi_r) < 0.5) {
        q13_r = floor(xi_r * 4096 + 0.5) * 0.000244140625;   // gain-ranged: +6 dB before the 12-bit converter
    }
    else {
        q13_r = floor(xi_r * 2048 + 0.5) * 0.00048828125;    // 12-bit
    }
    q_r = xi_r + (q13_r - xi_r) * lsb_q;
    q_l = fixnan(q_l);
    q_r = fixnan(q_r);
    if (g_w > 0.000001) {
        if (g_w < 0.999999) {
            g_ws = g_w * g_w * (3 - 2 * g_w);   // 4 ms smoothstep write fade (HOLD transitions only)
            q_l = peek(mem, w, 0) + (q_l - peek(mem, w, 0)) * g_ws;
            q_r = peek(mem, w, 1) + (q_r - peek(mem, w, 1)) * g_ws;
        }
        poke(mem, q_l, w, 0);
        poke(mem, q_r, w, 1);
    }
    g_w = g_w + clamp(w_tgt - g_w, -0.00390625, 0.00390625);
    relk = relk + 1;
    if (relk > 70000) {
        relk = 70000;
    }
    ra = w - na;
    if (ra < 0) {
        ra = ra + 65536;
    }
    ia = floor(ra);
    fa = ra - ia;
    ia2 = ia + 1;
    if (ia2 >= 65536) {
        ia2 = ia2 - 65536;
    }
    ta_l = peek(mem, ia, 0) * (1 - fa) + peek(mem, ia2, 0) * fa;
    ta_r = peek(mem, ia, 1) * (1 - fa) + peek(mem, ia2, 1) * fa;
    tb_l = ta_l;
    tb_r = ta_r;
    if (xf > 0.0000001 && xf < 0.9999999) {
        rb = w - nb;
        if (rb < 0) {
            rb = rb + 65536;
        }
        jb = floor(rb);
        fb2 = rb - jb;
        jb2 = jb + 1;
        if (jb2 >= 65536) {
            jb2 = jb2 - 65536;
        }
        tb_l = peek(mem, jb, 0) * (1 - fb2) + peek(mem, jb2, 0) * fb2;
        tb_r = peek(mem, jb, 1) * (1 - fb2) + peek(mem, jb2, 1) * fb2;
        wl = ta_l * g_a + tb_l * g_b;
        wr = ta_r * g_a + tb_r * g_b;
    }
    else {
        wl = ta_l;
        wr = ta_r;
        if (xf >= 0.9999999) {
            rb = w - nb;
            if (rb < 0) {
                rb = rb + 65536;
            }
            jb = floor(rb);
            fb2 = rb - jb;
            jb2 = jb + 1;
            if (jb2 >= 65536) {
                jb2 = jb2 - 65536;
            }
            wl = peek(mem, jb, 0) * (1 - fb2) + peek(mem, jb2, 0) * fb2;
            wr = peek(mem, jb, 1) * (1 - fb2) + peek(mem, jb2, 1) * fb2;
        }
    }
    if (gnt_w < 1) {
        wl = wl * gnt_w;
        wr = wr * gnt_w;
    }
    if (s_hm > 0.000001) {
        hr = hbase - 64512 + hpos;
        if (hr < 0) {
            hr = hr + 65536;
        }
        hv_l = peek(mem, hr, 0);
        hv_r = peek(mem, hr, 1);
        if (hpos >= 63488) {
            hg = (hpos - 63488) * 0.000976562500;   // seam crossfade
            hr2 = hr - 64512;
            if (hr2 < 0) {
                hr2 = hr2 + 65536;
            }
            hv_l = hv_l * sqrt(1 - hg) + peek(mem, hr2, 0) * sqrt(hg);
            hv_r = hv_r * sqrt(1 - hg) + peek(mem, hr2, 1) * sqrt(hg);
        }
        wl = wl + (hv_l - wl) * hm_w;
        wr = wr + (hv_r - wr) * hm_w;
    }
    dac_l = wl;
    dac_r = wr;
    w = w + 1;
    if (w >= 65536) {
        w = w - 65536;
    }
    hpos = hpos + 1;
    if (hpos >= 64512) {
        hpos = hpos - 64512;
    }
    tl = tt;
    tt = tt + tdt;
    nt = nt + 1;
}
acc_l = acc_l + dac_l * (1 - tl);
acc_r = acc_r + dac_r * (1 - tl);
hra = 0;
if (hst > 1.5) {
    hra = hbase - 64512 + hpos - w;   // how far the HOLD reader is ahead of the writer
    if (hra < 0) {
        hra = hra + 65536;
    }
    if (relk >= max(na, nb) + 3) {
        if (hst < 2.5) {
            hshape = 1;
        }
        hst = 0;     // the normal tap now reads only new audio -> crossfade the loop out
    }
    else if (relk + 3072 >= 65536 - hra - 1024 && hst < 2.5) {
        hshape = 1;
        hst = 3;     // reader would reach new audio first (delay > ~944 ms): fade the loop out now
    }
}
ph = ph + inc - nt;
if (ph >= 1) {
    ph = 0.999999;
}
if (ph < 0) {
    ph = 0;
}

// ===================== D/A -> LPF -> DE-EMPHASIS -> LOW/HIGH filters
ib1_l = h_ib1_l; ib2_l = h_ib2_l; ib1_r = h_ib1_r; ib2_r = h_ib2_r;
st_de_l = h_st_de_l; st_de_r = h_st_de_r;
eqz1_l = h_eqz1_l; eqz2_l = h_eqz2_l; eqz1_r = h_eqz1_r; eqz2_r = h_eqz2_r;
lc0_l = h_lc0_l; lc1_l = h_lc1_l; lc2_l = h_lc2_l; lc6_l = h_lc6_l; hcs_l = h_hcs_l;
lc0_r = h_lc0_r; lc1_r = h_lc1_r; lc2_r = h_lc2_r; lc6_r = h_lc6_r; hcs_r = h_hcs_r;

u3_l = acc_l - ib2_l;                       // reconstruction LPF (2-pole Butterworth)
u1_l = k_aa1 * ib1_l + k_aa2 * u3_l;
u2_l = ib2_l + k_aa2 * ib1_l + k_aa3 * u3_l;
ib1_l = fixdenorm(2 * u1_l - ib1_l);
ib2_l = fixdenorm(2 * u2_l - ib2_l);
eqy_l = eq_b0 * u2_l + eqz1_l;                // droop compensation (TDF-II biquad)
eqz1_l = fixdenorm(eq_b1 * u2_l - eq_a1 * eqy_l + eqz2_l);
eqz2_l = fixdenorm(eq_b2 * u2_l - eq_a2 * eqy_l);
uq_l = u2_l + (eqy_l - u2_l) * p_hf_comp;
v_tmp = (uq_l - st_de_l) * g_de;             // de-emphasis
dl_l = v_tmp + st_de_l;
st_de_l = fixdenorm(dl_l + v_tmp);
y_l = (dl_l + 0.3 * (uq_l - dl_l)) * 0.199526231;   // back to analog nominal
v_tmp = (y_l - lc0_l) * g_lc0;               // LOW cut: half-order (-3 dB/oct)
lp0_l = v_tmp + lc0_l;
lc0_l = fixdenorm(lp0_l + v_tmp);
z0_l = (y_l - lp0_l) + 0.5 * lp0_l;
v_tmp = (z0_l - lc1_l) * g_lc1;
lp1_l = v_tmp + lc1_l;
lc1_l = fixdenorm(lp1_l + v_tmp);
z1_l = (z0_l - lp1_l) + 0.5 * lp1_l;
v_tmp = (z1_l - lc2_l) * g_lc2;
lp2_l = v_tmp + lc2_l;
lc2_l = fixdenorm(lp2_l + v_tmp);
z2_l = (z1_l - lp2_l) + 0.5 * lp2_l;
v_tmp = (y_l - lc6_l) * g_lc6;               // LOW cut: alternative first-order (-6 dB/oct)
lp6_l = v_tmp + lc6_l;
lc6_l = fixdenorm(lp6_l + v_tmp);
z6_l = y_l - lp6_l;
zl_l = z2_l + (z6_l - z2_l) * s_lcs;
lo_l = y_l + (zl_l - y_l) * s_lca;
v_tmp = (lo_l - hcs_l) * g_hc;               // HIGH cut: first-order (-6 dB/oct)
hl_l = v_tmp + hcs_l;
hcs_l = fixdenorm(hl_l + v_tmp);
wet_l = lo_l + (hl_l - lo_l) * s_hca;
fbn_l = wet_l * s_fb * s_fbs * s_fbi + ret_l * s_ret * cal_live;   // regeneration: internal + EXT return


u3_r = acc_r - ib2_r;                       // reconstruction LPF (2-pole Butterworth)
u1_r = k_aa1 * ib1_r + k_aa2 * u3_r;
u2_r = ib2_r + k_aa2 * ib1_r + k_aa3 * u3_r;
ib1_r = fixdenorm(2 * u1_r - ib1_r);
ib2_r = fixdenorm(2 * u2_r - ib2_r);
eqy_r = eq_b0 * u2_r + eqz1_r;                // droop compensation (TDF-II biquad)
eqz1_r = fixdenorm(eq_b1 * u2_r - eq_a1 * eqy_r + eqz2_r);
eqz2_r = fixdenorm(eq_b2 * u2_r - eq_a2 * eqy_r);
uq_r = u2_r + (eqy_r - u2_r) * p_hf_comp;
v_tmp = (uq_r - st_de_r) * g_de;             // de-emphasis
dl_r = v_tmp + st_de_r;
st_de_r = fixdenorm(dl_r + v_tmp);
y_r = (dl_r + 0.3 * (uq_r - dl_r)) * 0.199526231;   // back to analog nominal
v_tmp = (y_r - lc0_r) * g_lc0;               // LOW cut: half-order (-3 dB/oct)
lp0_r = v_tmp + lc0_r;
lc0_r = fixdenorm(lp0_r + v_tmp);
z0_r = (y_r - lp0_r) + 0.5 * lp0_r;
v_tmp = (z0_r - lc1_r) * g_lc1;
lp1_r = v_tmp + lc1_r;
lc1_r = fixdenorm(lp1_r + v_tmp);
z1_r = (z0_r - lp1_r) + 0.5 * lp1_r;
v_tmp = (z1_r - lc2_r) * g_lc2;
lp2_r = v_tmp + lc2_r;
lc2_r = fixdenorm(lp2_r + v_tmp);
z2_r = (z1_r - lp2_r) + 0.5 * lp2_r;
v_tmp = (y_r - lc6_r) * g_lc6;               // LOW cut: alternative first-order (-6 dB/oct)
lp6_r = v_tmp + lc6_r;
lc6_r = fixdenorm(lp6_r + v_tmp);
z6_r = y_r - lp6_r;
zl_r = z2_r + (z6_r - z2_r) * s_lcs;
lo_r = y_r + (zl_r - y_r) * s_lca;
v_tmp = (lo_r - hcs_r) * g_hc;               // HIGH cut: first-order (-6 dB/oct)
hl_r = v_tmp + hcs_r;
hcs_r = fixdenorm(hl_r + v_tmp);
wet_r = lo_r + (hl_r - lo_r) * s_hca;
fbn_r = wet_r * s_fb * s_fbs * s_fbi + ret_r * s_ret * cal_live;   // regeneration: internal + EXT return


// ============================================================ OUTPUT
mx_l = a_l * s_bal_d + s_so * wet_l * s_bal_w;    // VARIABLE / +MIX
mn_l = a_l * s_bal_d - wet_l * s_bal_w;           // -MIX (always difference)
mx_r = a_r * s_bal_d + s_so * wet_r * s_bal_w;
dr_l = a_l * s_dir;                               // DIRECT
o_l = mx_l * s_m0 + dr_l * s_m1 + mx_l * s_m2 + mx_l * s_m3;
o_r = mx_l * s_m0 + mx_l * s_m1 + mn_l * s_m2 + mx_r * s_m3;
o_m = (o_l + o_r) * 0.5;
o_s = (o_l - o_r) * 0.5 * s_width;
o_l = o_m + o_s;
o_r = o_m - o_s;
og = s_oatt * s_ogain;
oc_l = ((o_l) / pow(1 + pow(abs(o_l), 5), 0.2));          // output amp rail (part of the character stage)
oc_r = ((o_r) / pow(1 + pow(abs(o_r), 5), 0.2));
sf_l = (o_l + (oc_l - o_l) * s_pre) * og;
sf_r = (o_r + (oc_r - o_r) * s_pre) * og;
// safety ceiling (modern): transparent below +6 dBFS, never above +12 dBFS
out1 = fixnan(sf_l / pow(1 + pow(abs(sf_l) * 0.25, 8), 0.125));
out2 = fixnan(sf_r / pow(1 + pow(abs(sf_r) * 0.25, 8), 0.125));
out3 = fixnan(20 * log10(max(mtr, 0.00001)) + 3);   // HEADROOM meter, dB
out4 = fixnan(m_s);                                  // LFO / ENV LED
out5 = fixnan(ms_disp);                              // delay time for the display (TIME, before LOOP COMP)
// v1.0.2-rc4: EXT loop send (device outputs 3/4): the regeneration tap after LOW/HIGH, unity gain
out6 = fixnan(wet_l / pow(1 + pow(abs(wet_l) * 0.25, 8), 0.125) * cal_live + cal_click);
out7 = fixnan(wet_r / pow(1 + pow(abs(wet_r) * 0.25, 8), 0.125) * cal_live + cal_click);
out8 = cal_out;                                      // rc5: CAL result for the patcher

// ============================================================= STORE
h_sr = fixnan(sr);
h_g_pre = fixnan(g_pre);
h_g_de = fixnan(g_de);
h_g_aa = fixnan(g_aa);
h_k_aa1 = fixnan(k_aa1);
