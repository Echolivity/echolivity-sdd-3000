// ECHOLIVITY SDD-3000 -- core DSP (gen~ codebox)
// Independent homage to the 1982 Korg SDD-3000. Not a Korg product.
// GENERATED by tools/make_gen.py -- edit the generator, not this file.
// v1.0.2: HOLD release fix + NaN/Inf protection (see docs/ENGINEERING_CHANGES.md).

Param p_in_range(2, min=0, max=2);   // input ATT  0=-30dBm(Hi-Z, extra amp) 1=-10dBm 2=+4dBm
Param p_in_level(5, min=0, max=10);   // input LEVEL, 5 = nominal
Param p_pre_on(1, min=0, max=1);   // preamp character stage on/off
Param p_drive(0, min=0, max=24);   // extra drive into op-amp stage, dB
Param p_tone(0, min=-1, max=1);   // tone tilt around 800 Hz (+-6 dB)
Param p_pre_comp(1, min=0, max=1);   // auto output compensation for drive
Param p_pre_trim(0, min=-24, max=24);   // preamp output trim, dB
Param p_time_ms(380, min=0, max=1023);   // delay time, ms
Param p_time_mode(0, min=0, max=1);   // 0=authentic 1 ms steps 1=continuous (modern)
Param p_time_glide(0, min=0, max=1);   // 0=click-free crossfade 1=glide/pitch-bend (modern)
Param p_sync(0, min=0, max=1);   // host tempo sync (modern)
Param p_division(8, min=0, max=12);   // note division index (modern); rc5 appends 11 = 1/16T, 12 = 1/32T
Param p_tempo(120, min=20, max=999);   // host tempo, BPM (sent by the patcher)
Param p_feedback(3, min=0, max=10);   // FEEDBACK 0..10 (loop gain = value/7)
Param p_fb_inv(0, min=0, max=1);   // regeneration INV
Param p_lowcut(0, min=0, max=3);   // LOW filter 0=FLAT 1=125 2=250 3=500 Hz
Param p_highcut(0, min=0, max=3);   // HIGH filter 0=FLAT 1=8k 2=4k 3=2k Hz
Param p_lc_slope(0, min=0, max=1);   // LOW slope 0=-3 dB/oct (spec) 1=-6 dB/oct (alt)
Param p_loop_sat(0, min=0, max=1);   // 0=converter hard clip (authentic) 1=soft loop saturation
Param p_hold(0, min=0, max=1);   // HOLD
Param p_fb_route(0, min=0, max=2);   // FB ROUTE 0=INT 1=EXT (send outs 3/4 -> return ins 3/4 replaces the internal loop) 2=BOTH
Param p_return(5, min=0, max=10);   // EXT RETURN level 0..10 (loop gain = value/7, same law as FEEDBACK)
Param p_loop_comp(0, min=0, max=250);   // LOOP COMP ms: shortens the delay in EXT so each external pass lands on time
Param p_cal(0, min=0, max=1);   // CAL trigger (rising edge): measure the external loop's round trip
Param p_waveform(0, min=0, max=3);   // 0=TRI 1=SQUARE 2=RND 3=ENV
Param p_intensity(0, min=0, max=10);   // INTENSITY 0..10 (10 = 2:1)
Param p_frequency(3, min=0, max=10);   // FREQUENCY 0..10 -> 0.1..15 Hz
Param p_env_sens(0, min=-24, max=24);   // envelope sensitivity dB (modern)
Param p_env_rel(1440, min=20, max=5000);   // envelope release ms (1440 = service-manual Fig.4)
Param p_balance(5, min=0, max=10);   // LEVEL BALANCE 0=direct 5=1:1 10=effect
Param p_out_inv(0, min=0, max=1);   // output INV (sum/difference on VARIABLE and +MIX)
Param p_bypass(0, min=0, max=1);   // BYPASS: direct only, delay input muted (clears loop)
Param p_out_range(2, min=0, max=2);   // output ATT 0=-20 1=-10 2=+4 dBm
Param p_out_mode(0, min=0, max=3);   // 0=MONO(VAR) 1=STEREO A(DIR/+MIX) 2=STEREO B(+MIX/-MIX) 3=TRUE STEREO
Param p_width(1, min=0, max=2);   // stereo width (modern)
Param p_wet_only(0, min=0, max=1);   // wet only (modern)
Param p_out_gain(0, min=-24, max=12);   // output gain dB (modern)
Param p_converter(0, min=0, max=1);   // 0=13-bit gain-ranged converter 1=clean (modern)
Param p_hf_comp(1, min=0, max=1);   // host-rate resampling droop compensation (engineering, keep on)

Data mem(65536, 2);
History h_cal_env(0);
